        {id:4,name:'明代建筑图谱',type:'图片',typeIcon:'fa-solid fa-image',typeColor:'#F56C6C',isbn:'978-7-308-ZZZZ-Z',code:'',author:'建筑研究所',editor:'陈编辑',pubDate:'2021-09',clc:'TU-092',topic:'建筑艺术',tags:['明代','建筑','图谱'],abstract_:'明代官式建筑标准图谱与工程做法。',statusKey:'indexed',statusLabel:'已索引',maturityLevel:'L3',chapters:12,paragraphs:2104,fragments:5620,esIndexed:true,version:'v2.1',searchCount:176,ragCount:82,apiCount:28,copyrightOwner:'浙大社',contractNo:'ZD20210088',authPeriod:'2021-09至2026-07',aiQA:true,training:true,delivery:true,authRisk:'中',updatedAt:'2026-06-05'},
        {id:5,name:'近代教育史料汇编',type:'数据集',typeIcon:'fa-solid fa-database',typeColor:'#9370DB',isbn:'',code:'EDU-2023-005',author:'教育研究所',editor:'刘编辑',pubDate:'2023-11',clc:'G529',topic:'教育史料',tags:['近代','教育','史料'],abstract_:'近代中国教育制度变迁原始文献数据集。',statusKey:'pending',statusLabel:'待处理',maturityLevel:'L0',chapters:0,paragraphs:0,fragments:0,esIndexed:false,version:'-',searchCount:12,ragCount:0,apiCount:0,copyrightOwner:'待确认',contractNo:'-',authPeriod:'-',aiQA:false,training:false,delivery:false,authRisk:'高',updatedAt:'2026-06-01'}
      ]);

      const filteredAssets=computed(()=>{
        return assetsData.value.filter(a=>{
          if(assetSearch.value&&!a.name.includes(assetSearch.value))return false;
          if(filterType.value&&a.type!==filterType.value)return false;
          if(filterStatus.value&&a.statusLabel!==filterStatus.value)return false;
          if(filterMaturity.value&&a.maturityLevel!==filterMaturity.value)return false;
          if(activeTopic.value!=='all'){
            const t=topics.value.find(x=>x.id===activeTopic.value);
            if(t&&a.topic!==t.name)return false;
          }
          return true;
        });
      });

      const selectAsset=(asset)=>{
        selectedAsset.value=asset;
        detailTab.value='meta';
      };

      // MOD-02 推送门禁
      const pushDialogVisible=ref(false);
      const onPushToPlatform=()=>{
        const a=selectedAsset.value;
        if(!a)return;
        // 门禁校验
        if(a.maturityLevel==='L0'){showToast('门禁拦截：该资源尚未结构化（L0），不可推送','warning');return}
        if(!a.aiQA&&a.authRisk==='高'){showToast('门禁拦截：版权未确认/高风险，不可推送','error');return}
        pushDialogVisible.value=true;
      };
      const confirmPush=()=>{
        const a=selectedAsset.value;
        pushDialogVisible.value=false;
        addAuditLog({action:'管理',actionType:'success',target:a.name,detail:'推送至高质量数据集加工平台'});
        pushNotif(`《${a.name}》已推送至加工平台`,'fa-solid fa-paper-plane','#409EFF','api-callback');
        showToast('已推送至加工平台，回流后自动更新','success');
      };

      const openStructResultFromAsset=()=>{
        const a=selectedAsset.value;
        if(!a)return;
        currentPage.value='resource-struct';
        structLibSearch.value=a.name;
        structFilterTip.value=`已按资产目录所选资源筛选：${a.name}`;
      };

      // MOD-05 编辑元数据
      const editMetaDialogVisible=ref(false);
      const editMetaForm=reactive({});
      const openEditMetaDialog=()=>{
        const a=selectedAsset.value;if(!a)return;
        Object.assign(editMetaForm,{isbn:a.isbn,cip:a.cip||'',author:a.author,editor:a.editor,pubDate:a.pubDate,clc:a.clc,topic:a.topic,tagsStr:(a.tags||[]).join('、'),abstract_:a.abstract_||''});
        editMetaDialogVisible.value=true;
      };
      const saveEditMeta=()=>{
        const a=selectedAsset.value;
        a.isbn=editMetaForm.isbn;a.cip=editMetaForm.cip;a.author=editMetaForm.author;
        a.editor=editMetaForm.editor;a.pubDate=editMetaForm.pubDate;a.clc=editMetaForm.clc;
        a.topic=editMetaForm.topic;a.tags=editMetaForm.tagsStr.split('、').filter(Boolean);a.abstract_=editMetaForm.abstract_;
        editMetaDialogVisible.value=false;
        addAuditLog({action:'管理',target:a.name,detail:'编辑出版元数据'});
        showToast('元数据已保存','success');
      };

      // MOD-05/16 管理授权
      const editAuthDialogVisible=ref(false);
      const editAuthForm=reactive({});
      const openEditAuthDialog=(asset)=>{
        const a=asset||selectedAsset.value;if(!a)return;
        const name=a.name||a.resource;
        Object.assign(editAuthForm,{resource:name,contractNo:a.contractNo,authFile:'',authPeriod:a.authPeriod,dbDisplay:true,aiQA:a.aiQA,training:a.training,delivery:a.delivery,thirdPartyStatus:'无',risk:a.risk||a.authRisk});
        editAuthDialogVisible.value=true;
      };
      const saveEditAuth=()=>{
        const a=assetsData.value.find(x=>x.name===editAuthForm.resource);
        if(a){
          a.contractNo=editAuthForm.contractNo;a.authPeriod=editAuthForm.authPeriod;
          a.aiQA=editAuthForm.aiQA;a.training=editAuthForm.training;a.delivery=editAuthForm.delivery;a.authRisk=editAuthForm.risk;
        }
        // 同步版权台账（无论是否有对应资产）
        const cl=store.copyrightLedger.find(c=>c.resource===editAuthForm.resource);
        if(cl){cl.aiQA=editAuthForm.aiQA;cl.training=editAuthForm.training;cl.delivery=editAuthForm.delivery;cl.risk=editAuthForm.risk;cl.contractNo=editAuthForm.contractNo;cl.authPeriod=editAuthForm.authPeriod}
        editAuthDialogVisible.value=false;
        addAuditLog({action:'管理',target:editAuthForm.resource,detail:`修改授权：AI问答=${editAuthForm.aiQA?'允许':'禁止'}，训练=${editAuthForm.training?'允许':'禁止'}`});
        showToast('授权已更新，RAG/推送将按新状态联动','success');
      };

      // MOD-16 下载门禁
      const downloadDialogVisible=ref(false);
      const downloadTitle=ref('');const downloadMsg=ref('');const downloadAllowed=ref(false);const downloadTarget=ref(null);
      const onDownloadOriginal=()=>{
        const a=selectedAsset.value;if(!a)return;
        downloadTarget.value={name:a.name,type:'asset'};
        downloadTitle.value='下载原件';
        if(!a.delivery){downloadMsg.value='门禁拦截：该资源版权授权禁止对外交付，不可下载原件。如需使用请联系版权管理员。';downloadAllowed.value=false}
        else{downloadMsg.value='确认下载《'+a.name+'》原件？此操作将记入审计日志。';downloadAllowed.value=true}
        downloadDialogVisible.value=true;
      };
      const onDownloadOriginalFile=(row)=>{
        downloadTarget.value={name:row.name,type:'file'};
        downloadTitle.value='下载文件';
        downloadMsg.value='确认下载'+row.name+'？此操作将记入审计日志。';
        downloadAllowed.value=true;
        downloadDialogVisible.value=true;
      };
      const confirmDownload=()=>{
        downloadDialogVisible.value=false;
        addAuditLog({action:'下载',actionType:'warning',target:downloadTarget.value.name,detail:'下载原件'});
        showToast('下载已开始，已记入审计日志','success');
      };

      // ===== 资产编目（重构 v2.0：顶部统计卡片 + 9字段列表 + 5区详情）=====
      const enrollmentData=ref([
        {code:'AC-2026-001',name:'大运河水利史',type:'图书',isbn:'978-7-5343-XXXX-X',cip:'已登记',author:'王水利',editor:'张某某',pubDate:'2024-03',clc:'TV882',series:'水利工程/运河专题',source:'原始PDF',copyrightStatus:'已确认',completeness:95,status:'已发布',nextAction:'查看详情',risk:'低'},
        {code:'AC-2026-002',name:'中医药图鉴·上册',type:'图书',isbn:'978-7-5343-YYYY-Y',cip:'缺失',author:'李时珍(编)',editor:'待指定',pubDate:'2023-11',clc:'R281',series:'医药教材',source:'ERP导入',copyrightStatus:'已确认',completeness:82,status:'待补全',nextAction:'确认版权',risk:'低'},
        {code:'AC-2026-003',name:'近代教育史料汇编',type:'图书',isbn:'',cip:'缺失',author:'教育研究所',editor:'待指定',pubDate:'2024-08',clc:'G529',series:'教育史料',source:'手工导入',copyrightStatus:'待确认',completeness:45,status:'草稿',nextAction:'补全信息',risk:'中'},
        {code:'AC-2026-004',name:'明代建筑图谱',type:'图片',isbn:'978-7-5343-AAAA-A',cip:'已登记',author:'陈建华',editor:'李主任',pubDate:'2023-06',clc:'TU-0',series:'古建筑',source:'原始PDF',copyrightStatus:'已确认',completeness:98,status:'待审批',nextAction:'提交审批',risk:'低'},
        {code:'AC-2026-005',name:'非物质文化遗产口述实录',type:'音视频',isbn:'',cip:'缺失',author:'非遗工作组',editor:'待指定',pubDate:'2024-12',clc:'K892',series:'非遗文化',source:'ERP导入',copyrightStatus:'有风险',completeness:30,status:'草稿',nextAction:'补全信息',risk:'高'},
      ]);
      const selectedEnrollment=ref(null);
      const enrollmentIssues=computed(()=>{
        const issues=[];
        const missingISBN=enrollmentData.value.filter(e=>!e.isbn);
        const pendingCopyright=enrollmentData.value.filter(e=>e.copyrightStatus!=='已确认');
        if(missingISBN.length)issues.push(`${missingISBN.length}条资源缺少ISBN，请尽快补全`);
        if(pendingCopyright.length)issues.push(`${pendingCopyright.length}条资源版权状态待确认，影响后续结构化与检索`);
        return issues
      });
      const enrollmentStats=computed(()=>({
        missingMeta:enrollmentData.value.filter(e=>!e.isbn||e.cip==='缺失'||e.editor==='待指定').length,
        pendingCopyright:enrollmentData.value.filter(e=>e.copyrightStatus!=='已确认').length,
        pendingSubmit:enrollmentData.value.filter(e=>e.completeness>=80&&e.status==='待审批').length,
        todayDone:2
      }));
      const submitEnrollment=(row)=>{
        if(row.completeness<60){showToast('编目完整率不足60%（缺少ISBN等必填项），请补全后再提交','warning');return}
        row.status='待审批';row.nextAction='查看详情';
        addAuditLog({action:'管理',target:row.name,detail:'提交编目审批，完整率'+row.completeness+'%'});
        showToast('已提交审批','success');
      };
      const selectEnrollment=(row)=>{selectedEnrollment.value=row};
      const handleNextAction=(row)=>{
        if(row.nextAction==='补全信息'||row.nextAction==='确认版权'){
          selectEnrollment(row);
          showToast('请在右侧详情面板补全缺失字段','info');
        }else if(row.nextAction==='查看详情')selectEnrollment(row);
        else showToast('已'+row.nextAction,'info');
      };
      const getCompletenessItems=(row)=>{
        if(!row)return[];
        return [
          {item:'书名',done:!!row.name},
          {item:'资产编码',done:!!row.code},
          {item:'ISBN',done:!!row.isbn},
          {item:'CIP',done:row.cip!=='缺失'},
          {item:'作者/主编',done:!!row.author},
          {item:'责任编辑',done:row.editor!=='待指定'},
          {item:'分类号',done:!!row.clc},
          {item:'版权状态',done:row.copyrightStatus==='已确认'},
          {item:'授权范围',done:row.copyrightStatus==='已确认'&&(row.risk||'低')==='低'},
          {item:'原始文件',done:row.source!=='缺失'}
        ];
      };
      const enrollmentAuthItems=computed(()=>{
        if(!selectedEnrollment.value)return [];
        const r=selectedEnrollment.value;
        return [
          {name:'数据库展示',status:r.copyrightStatus==='已确认'?'已允许':r.copyrightStatus==='待确认'?'待确认':'不允许'},
          {name:'内部AI问答',status:r.copyrightStatus==='已确认'?'已允许':'待确认'},
          {name:'模型训练',status:r.risk==='高'?'不允许':'待确认'},
          {name:'对外交付',status:r.status==='已发布'?'已允许':'待确认'},
          {name:'授权期限',value:r.pubDate?r.pubDate.split('-')[0]+'-'+(parseInt(r.pubDate.split('-')[0])+3):'待补全'},
          {name:'合同编号',value:r.code==='AC-2026-005'?'HT-2024-xxx':'待补全'},
        ];
      });

      // ===== 分级分类 / 标签 =====
      const classificationTree=ref([
        {name:'历史文献',icon:'fa-solid fa-landmark',color:'#8B4513',count:326,children:[{name:'运河水利',count:48},{name:'地方史志',count:120},{name:'近代史料',count:76}]},
        {name:'中医药学',icon:'fa-solid fa-mortar-pestle',color:'#228B22',count:218,children:[{name:'药材图鉴',count:95},{name:'方剂文献',count:123}]},
        {name:'非遗文化',icon:'fa-solid fa-mask',color:'#DAA520',count:154,children:[{name:'传统技艺',count:67},{name:'民俗',count:87}]},
        {name:'建筑艺术',icon:'fa-solid fa-building',color:'#4682B4',count:98,children:[{name:'古建筑',count:62},{name:'工程图谱',count:36}]}
      ]);
      const securityLevels=ref([
        {name:'公开级',short:'公',color:'#67C23A',desc:'可公开访问与检索',count:892},
        {name:'内部级',short:'内',color:'#409EFF',desc:'内部授权访问',count:268},
        {name:'敏感级',short:'敏',color:'#E6A23C',desc:'需审批后访问',count:72},
        {name:'机密级',short:'机',color:'#F56C6C',desc:'严格限制访问',count:15}
      ]);
      const maturityLevels=ref([
        {level:'L0',name:'未结构化（原始文件）',color:'#909399'},
        {level:'L1',name:'已解析（机器结构化）',color:'#409EFF'},
        {level:'L2',name:'已校准（人工修正）',color:'#67C23A'},
        {level:'L3',name:'已审核（质检通过）',color:'#E6A23C'},
        {level:'L4',name:'已发布（上线可用）',color:'#F56C6C'}
      ]);
      const tagCategories=ref([
        {name:'学科分类',icon:'fa-solid fa-book',color:'#409EFF',tags:['历史','医学','建筑','教育','文学','艺术']},
        {name:'资源形态',icon:'fa-solid fa-shapes',color:'#67C23A',tags:['图书','期刊','图谱','音视频','数据集','档案']},
        {name:'业务标签',icon:'fa-solid fa-briefcase',color:'#E6A23C',tags:['重点项目','教材申报','数字人文','非遗保护','科研成果']}
      ]);

      // ===== MOD-10 资源接入 =====
      const uploadStep=ref(0);
      const uploadStatus=ref('');const uploadStatusType=ref('info');
      const uploadChecks=ref([
        {name:'文件格式校验',pass:true},{name:'MD5去重检查',pass:true},{name:'ISBN/CIP元数据',pass:false},{name:'版权状态标识',pass:false},{name:'对象存储归档',pass:true}
      ]);
      const businessSystems=ref([
        {name:'编辑业务系统',icon:'fa-solid fa-pen-nib',color:'#409EFF',mode:'API对接',active:true},
        {name:'版权管理系统',icon:'fa-solid fa-copyright',color:'#E6A23C',mode:'数据同步',active:true},
        {name:'印刷管理系统',icon:'fa-solid fa-print',color:'#67C23A',mode:'定时同步',active:false}
      ]);
      const uploadDialogVisible=ref(false);const uploadSimulating=ref(false);
      const startUpload=()=>{uploadDialogVisible.value=true};
      const runUploadSimulation=()=>{
        uploadSimulating.value=true;
        const steps=['新增上传文件记录','格式校验中…','校验通过','元数据缺失提示补全','版权状态确认','入库归档','审计日志写入'];
        let i=0;
        const timer=setInterval(()=>{
          if(i>=steps.length){
            clearInterval(timer);uploadSimulating.value=false;uploadDialogVisible.value=false;
            // 联动：原始资源库新增
            const newRes={id:'R'+String(store.rawResources.length+1).padStart(3,'0'),name:'新上传文档_'+Date.now().toString().slice(-4)+'.pdf',format:'PDF',size:'12.3MB',md5:'d'+Date.now().toString(16).slice(0,11)+'...',source:'编辑上传',uploadedAt:new Date().toLocaleString('zh-CN'),checkStatus:'registered',checkLabel:'已归档'};
            store.rawResources.unshift(newRes);
            addAuditLog({action:'上传',actionType:'success',target:newRes.name,detail:'模拟上传流程，已归档至原始资源库'});
            pushNotif(`新资源《${newRes.name}》已归档`,'fa-solid fa-cloud-arrow-up','#67C23A','resource-original');
            showToast('模拟上传完成，已联动原始资源库与审计日志','success');
            return;
          }
          uploadStatus.value=steps[i];uploadStatusType.value=i<2?'info':i<5?'warning':'success';
          if(i===2){uploadStep.value=3}
          if(i===4){uploadChecks.value[2].pass=true;uploadChecks.value[3].pass=true;uploadStep.value=5}
          if(i===5){uploadStep.value=6}
          i++;
        },500);
      };

      // ===== MOD-11/12 解析引擎 =====
      const parseEngines=ref([
        {name:'PDF智能解析引擎',icon:'fa-solid fa-file-pdf',color:'#F56C6C',desc:'PDF版面分析+OCR+表格公式识别'},
        {name:'EPUB结构化引擎',icon:'fa-solid fa-book',color:'#409EFF',desc:'EPUB章节拆解+语义标注'},
        {name:'OCR图文识别引擎',icon:'fa-solid fa-font',color:'#E6A23C',desc:'图片文字识别+版面恢复'}
      ]);
      const parseDialogVisible=ref(false);
      const parseForm=reactive({fileName:'',engine:'PDF智能解析引擎',ocr:true,table:true,formula:true,pageMap:true,report:true});
      const openParseDialog=()=>{
        parseForm.fileName='（请选择目标文件）';
        parseDialogVisible.value=true;
      };
      const openParseDialogFor=(row)=>{
        parseForm.fileName=row.name;
        parseDialogVisible.value=true;
      };
      const confirmParse=()=>{
        const task={id:'T'+Date.now(),bookName:parseForm.fileName,pages:Math.floor(Math.random()*200)+80,engine:parseForm.engine,ocrAccuracy:(95+Math.random()*4).toFixed(1)+'%',lowConfPages:Math.floor(Math.random()*8)+2,progress:0,report:null};
        store.parseTasks.unshift(task);
        parseDialogVisible.value=false;
        addAuditLog({action:'结构化入库',actionType:'success',target:parseForm.fileName,detail:'手动补发结构化解析，引擎：'+parseForm.engine});
        showToast('解析任务已创建，请到解析引擎页查看进度','success');
        // 模拟进度推进
        const progTimer=setInterval(()=>{
          task.progress+=Math.floor(Math.random()*15)+5;
          if(task.progress>=100){
            task.progress=100;
            task.report={taskId:task.id,pages:task.pages,successPages:task.pages-Math.floor(Math.random()*5),failedPages:Math.floor(Math.random()*5),chapters:Math.floor(Math.random()*8)+4,paragraphs:Math.floor(Math.random()*800)+400,figures:Math.floor(Math.random()*100)+20,formulas:Math.floor(Math.random()*20),lowConfPages:task.lowConfPages};
            clearInterval(progTimer);
            pushNotif(`《${task.bookName}》解析完成`,'fa-solid fa-check','#67C23A','struct-parse');
          }
        },800);
      };
      const parseReportVisible=ref(false);const parseReportData=ref(null);
      const openParseReport=(row)=>{
        parseReportData.value=row.report||{taskId:row.id,pages:row.pages,successPages:row.pages,failedPages:0,chapters:8,paragraphs:1200,figures:40,formulas:10,lowConfPages:row.lowConfPages};
        parseReportVisible.value=true;
      };
      const retryParse=(row)=>{
        row.progress=0;
        addAuditLog({action:'结构化入库',target:row.bookName,detail:'重新发起解析'});
        showToast('已重新发起解析','info');
        const t=setInterval(()=>{row.progress+=Math.floor(Math.random()*20)+10;if(row.progress>=100){row.progress=100;clearInterval(t);showToast(`《${row.bookName}》解析完成`,'success')}},600);
      };

      // ===== MOD-08/13 校准工作台 =====
      const calibrationChapters=ref([
        {id:'c1',name:'第一节 漕运管理机构的演变',active:true},
        {id:'c2',name:'第二节 明清时期的运河管理体系',active:false},
