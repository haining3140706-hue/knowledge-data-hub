  // helper: 追加审计日志（Append-Only 模拟）
  function addAuditLog(entry){
    const id=store.auditLogs.length?store.auditLogs[0].id+1:1;
    const now=new Date();
    const pad=n=>String(n).padStart(2,'0');
    const time=`${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
    store.auditLogs.unshift({id,time,user:entry.user||'数据治理管理员',action:entry.action,actionType:entry.actionType||'primary',target:entry.target,detail:entry.detail,ip:entry.ip||'10.0.1.23',success:entry.success!==false});
  }

  // helper: 推送通知
  function pushNotif(text,icon,color,page){
    const id=store.notifications.length?Math.max(...store.notifications.map(n=>n.id))+1:1;
    store.notifications.unshift({id,text,time:'刚刚',icon:icon||'fa-solid fa-bell',color:color||'#409EFF',read:false,page:page||'dashboard'});
  }

