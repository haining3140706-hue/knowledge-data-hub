          item.text=t1;
          const idx=structItems.value.indexOf(item);
          structItems.value.splice(idx+1,0,{id:'s'+Date.now(),typeLabel:item.typeLabel,typeTag:item.typeTag,confidence:item.confidence,page:item.page,text:t2});
        }
        calibHistory.value.unshift({time:new Date().toLocaleString('zh-CN'),action:`拆分段落 ${splitParaForm.id}`,reason:'人工拆分，位置第'+splitParaForm.position+'字'});
        splitParaDialogVisible.value=false;
        showToast('段落已拆分','success');
      };

      // MOD-08 提交审核
      const submitAuditDialogVisible=ref(false);
      const submitCalibration=()=>{submitAuditDialogVisible.value=true};
      const confirmSubmitAudit=()=>{
