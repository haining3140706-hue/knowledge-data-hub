        editParaDialogVisible.value=true;
      };
      const saveEditPara=()=>{
        const item=structItems.value.find(x=>x.id===editParaForm.id);
        if(item){item.typeLabel=editParaForm.typeLabel;item.text=editParaForm.text;item.page=editParaForm.page;item.confidence=Number(editParaForm.confidence)}
        calibHistory.value.unshift({time:new Date().toLocaleString('zh-CN'),action:`编辑段落 ${editParaForm.id}`,reason:editParaForm.reason||'人工修正'});
        editParaDialogVisible.value=false;
        showToast('段落已保存，修改已记入历史','success');
      };
      const splitParaDialogVisible=ref(false);
      const splitParaForm=reactive({id:'',originalText:'',position:0});
      const openSplitParagraph=(item)=>{
        Object.assign(splitParaForm,{id:item.id,originalText:item.text,position:Math.floor(item.text.length/2)});
        splitParaDialogVisible.value=true;
      };
      const confirmSplit=()=>{
        const item=structItems.value.find(x=>x.id===splitParaForm.id);
