<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>知识数据中台 · Knowledge Data Hub</title>
  <link rel="stylesheet" href="https://unpkg.com/element-plus@2.7.3/dist/index.css">
  <link rel="stylesheet" href="https://unpkg.com/element-plus@2.7.3/theme-chalk/dark/css-vars.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;700;900&display=swap" rel="stylesheet">
  <style>
    :root{--primary:#409EFF;--primary-dark:#337ECC;--success:#67C23A;--warning:#E6A23C;--danger:#F56C6C;--info:#909399;--sidebar-width:220px;--header-height:56px;--detail-width:480px;--transition:all .3s cubic-bezier(.4,0,.2,1)}
    *{margin:0;padding:0;box-sizing:border-box}
    html,body{height:100%;font-family:'Noto Sans SC',-apple-system,BlinkMacSystemFont,sans-serif}
    #app{height:100%}
    .app-container{display:flex;flex-direction:column;height:100vh;overflow:hidden}
    .app-header{height:var(--header-height);background:linear-gradient(135deg,#1a1a2e 0%,#16213e 50%,#0f3460 100%);display:flex;align-items:center;padding:0 20px;color:#fff;z-index:100;box-shadow:0 2px 12px rgba(0,0,0,.15)}
    .app-header.dark{background:linear-gradient(135deg,#0d1117 0%,#161b22 50%,#21262d 100%)}
    .app-body{display:flex;flex:1;overflow:hidden}
    .app-sidebar{width:var(--sidebar-width);background:#fff;border-right:1px solid #e8e8e8;overflow-y:auto;transition:var(--transition);flex-shrink:0}
    html.dark .app-sidebar{background:#1d1e1f;border-color:#363637}
    .app-sidebar.collapsed{width:64px}
    .app-sidebar.collapsed .menu-text{display:none}
    .app-sidebar.collapsed .el-menu{width:64px}
    .sidebar-logo{height:48px;display:flex;align-items:center;padding:0 16px;gap:10px;border-bottom:1px solid #e8e8e8;cursor:pointer}
    html.dark .sidebar-logo{border-color:#363637}
    .sidebar-logo .logo-icon{font-size:22px;color:var(--primary)}
    .sidebar-logo .logo-text{font-size:15px;font-weight:700;color:#303133;white-space:nowrap}
    html.dark .sidebar-logo .logo-text{color:#e5eaf3}
    .app-main{flex:1;overflow:auto;background:#f5f7fa;padding:16px}
    html.dark .app-main{background:#141414}
    .header-left{display:flex;align-items:center;gap:16px;flex:1}
    .header-logo{display:flex;align-items:center;gap:8px}
    .header-logo i{font-size:24px;color:#67C8FF}
    .header-logo span{font-size:16px;font-weight:700;letter-spacing:1px}
    .header-search{max-width:480px;flex:1}
    .header-search .el-input__wrapper{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.15);border-radius:8px;color:#fff}
    .header-search .el-input__inner{color:#fff}
    .header-search .el-input__inner::placeholder{color:rgba(255,255,255,.5)}
    .header-right{display:flex;align-items:center;gap:16px}
    .header-btn{cursor:pointer;color:rgba(255,255,255,.8);font-size:18px;transition:var(--transition);padding:6px;border-radius:6px}
    .header-btn:hover{color:#fff;background:rgba(255,255,255,.1)}
    .header-user{display:flex;align-items:center;gap:8px;cursor:pointer;color:rgba(255,255,255,.9)}
    .header-user .el-avatar{border:2px solid rgba(255,255,255,.3)}
    .notif-panel{position:absolute;top:56px;right:16px;width:380px;max-height:480px;background:#fff;border-radius:10px;box-shadow:0 8px 32px rgba(0,0,0,.18);overflow:hidden;z-index:2000;border:1px solid #ebeef5}
    html.dark .notif-panel{background:#1d1e1f;border-color:#363637}
    .notif-header{padding:12px 16px;border-bottom:1px solid #f0f0f0;display:flex;align-items:center;justify-content:space-between}
    html.dark .notif-header{border-color:#363637}
    .notif-header .nh-title{font-size:14px;font-weight:700;color:#303133}
    html.dark .notif-header .nh-title{color:#e5eaf3}
    .notif-list{max-height:380px;overflow-y:auto}
    .notif-item{padding:12px 16px;border-bottom:1px solid #f5f5f5;cursor:pointer;transition:var(--transition);display:flex;gap:10px;align-items:flex-start}
    html.dark .notif-item{border-color:#2c2c2c}
    .notif-item:hover{background:#f0f7ff}
    html.dark .notif-item:hover{background:#1a2a3c}
    .notif-item .ni-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:14px;color:#fff;flex-shrink:0}
    .notif-item .ni-body{flex:1;min-width:0}
    .notif-item .ni-text{font-size:13px;color:#303133;line-height:1.5}
    html.dark .notif-item .ni-text{color:#e5eaf3}
    .notif-item .ni-time{font-size:11px;color:#909399;margin-top:4px}
    .notif-item.read{opacity:.55}
    .notif-empty{padding:40px 20px;text-align:center;color:#909399;font-size:13px}
    .flow-overview{background:#fff;border-radius:12px;padding:20px 24px;margin-bottom:16px;border:1px solid #ebeef5}
    html.dark .flow-overview{background:#1d1e1f;border-color:#363637}
    .flow-title{font-size:14px;font-weight:700;color:#303133;margin-bottom:16px;display:flex;align-items:center;gap:8px}
    html.dark .flow-title{color:#e5eaf3}
    .flow-main{display:flex;align-items:center;gap:6px;flex-wrap:nowrap;overflow-x:auto;padding-bottom:12px}
    .flow-node{background:linear-gradient(135deg,#ecf5ff,#f0f9eb);border:1px solid #d9ecff;border-radius:10px;padding:10px 16px;min-width:140px;text-align:center;flex-shrink:0;cursor:pointer;transition:var(--transition)}
    .flow-node:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(64,158,255,.2);border-color:var(--primary)}
    html.dark .flow-node{background:#1a2a3c;border-color:#2a4a6c}
    .flow-node .node-label{font-size:12px;color:#909399;margin-bottom:2px}
    .flow-node .node-value{font-size:18px;font-weight:800;color:#409EFF}
    .flow-node .node-sub{font-size:10px;color:#b0b5bd}
    .flow-arrow{color:#c0c4cc;font-size:18px;flex-shrink:0}
    .flow-audit{margin-top:10px;background:#fdf6ec;border:1px solid #faecd8;border-radius:8px;padding:8px 16px;text-align:center;font-size:12px;color:#E6A23C;font-weight:500;cursor:pointer}
    html.dark .flow-audit{background:#3a2a1a;border-color:#5a4a3a;color:#E6A23C}
    .stat-card{background:#fff;border-radius:12px;padding:20px;position:relative;overflow:hidden;box-shadow:0 1px 6px rgba(0,0,0,.06);transition:var(--transition);cursor:pointer}
    html.dark .stat-card{background:#1d1e1f;box-shadow:0 1px 6px rgba(0,0,0,.2)}
    .stat-card:hover{transform:translateY(-2px);box-shadow:0 4px 16px rgba(0,0,0,.1)}
    .stat-card .stat-icon{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;color:#fff;margin-bottom:12px}
    .stat-card .stat-value{font-size:28px;font-weight:900;color:#303133;line-height:1.2}
    html.dark .stat-card .stat-value{color:#e5eaf3}
    .stat-card .stat-label{font-size:13px;color:#909399;margin-top:4px}
    .stat-card .stat-trend{font-size:12px;margin-top:8px;display:flex;align-items:center;gap:4px}
    .stat-card .stat-bg{position:absolute;right:-10px;bottom:-10px;font-size:80px;opacity:.04}
    .stat-card .stat-drill{position:absolute;top:16px;right:16px;font-size:11px;color:#409EFF;opacity:0;transition:var(--transition)}
    .stat-card:hover .stat-drill{opacity:1}
    .catalog-layout{display:flex;height:calc(100vh - var(--header-height) - 32px);gap:12px}
    .catalog-left{width:260px;flex-shrink:0;background:#fff;border-radius:10px;overflow-y:auto;padding:12px}
    html.dark .catalog-left{background:#1d1e1f}
    .catalog-center{flex:1;background:#fff;border-radius:10px;display:flex;flex-direction:column;overflow:hidden}
    html.dark .catalog-center{background:#1d1e1f}
    .catalog-right{width:0;background:#fff;border-radius:10px;overflow:hidden;transition:width .35s cubic-bezier(.4,0,.2,1);flex-shrink:0}
    html.dark .catalog-right{background:#1d1e1f}
    .catalog-right.open{width:var(--detail-width)}
    /* 资产编目 v2.0 */
    .enroll-stat-card{background:#fff;border:1px solid #ebeef5;border-radius:10px;padding:16px;text-align:center;transition:all .3s cubic-bezier(.4,0,.2,1)}
    .enroll-stat-card.clickable{cursor:pointer}.enroll-stat-card.clickable:hover{border-color:var(--primary);box-shadow:0 2px 12px rgba(64,158,255,.1)}
    .enroll-stat-num{font-size:32px;font-weight:900;line-height:1.2}
    .enroll-stat-label{font-size:12px;color:#909399;margin-top:4px}
    .detail-section-title{font-size:14px;font-weight:600;color:#303133}
    .detail-row{display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f5f5f5;font-size:13px}
    .detail-row:last-child{border-bottom:none}
    .detail-label{color:#909399;flex-shrink:0;margin-right:12px}
    .mb-12{margin-bottom:12px}
    .topic-tree .topic-node{display:flex;align-items:center;padding:8px 12px;border-radius:8px;cursor:pointer;transition:var(--transition);margin-bottom:2px}
    .topic-tree .topic-node:hover{background:#f0f5ff}
    .topic-tree .topic-node.active{background:#ecf5ff;color:var(--primary)}
    html.dark .topic-tree .topic-node:hover{background:#262727}
    html.dark .topic-tree .topic-node.active{background:#1a3a5c}
    .topic-tree .topic-icon{margin-right:8px;font-size:16px}
    .topic-tree .topic-name{flex:1;font-size:13px;font-weight:500}
    .topic-tree .topic-count{font-size:11px;color:#909399;background:#f0f2f5;padding:2px 8px;border-radius:10px}
    html.dark .topic-tree .topic-count{background:#2c2c2c}
    .asset-toolbar{padding:12px 16px;border-bottom:1px solid #f0f0f0;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    html.dark .asset-toolbar{border-color:#363637}
    .asset-list{flex:1;overflow-y:auto;padding:12px}
    .asset-card{border:1px solid #ebeef5;border-radius:10px;padding:14px 16px;cursor:pointer;transition:var(--transition);margin-bottom:8px;display:flex;align-items:flex-start;gap:12px}
    .asset-card:hover{border-color:var(--primary);box-shadow:0 2px 12px rgba(64,158,255,.1)}
    .asset-card.active{border-color:var(--primary);background:#f0f7ff}
    html.dark .asset-card{border-color:#363637}
    html.dark .asset-card:hover{border-color:var(--primary)}
    html.dark .asset-card.active{background:#1a3a5c;border-color:var(--primary)}
    .asset-card .asset-type-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
    .asset-card .asset-info{flex:1;min-width:0}
    .asset-card .asset-name{font-size:14px;font-weight:600;color:#303133;margin-bottom:4px}
    html.dark .asset-card .asset-name{color:#e5eaf3}
    .asset-card .asset-meta{font-size:12px;color:#909399;display:flex;gap:12px;flex-wrap:wrap}
    .asset-card .asset-tags{display:flex;gap:4px;margin-top:6px;flex-wrap:wrap}
    .detail-panel{padding:16px 20px;overflow-y:auto;height:100%}
    .detail-panel .detail-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
    .detail-panel .detail-title{font-size:16px;font-weight:700;color:#303133}
    html.dark .detail-panel .detail-title{color:#e5eaf3}
    .detail-field{display:flex;justify-content:space-between;padding:6px 0;font-size:12px;border-bottom:1px solid #f5f5f5}
    html.dark .detail-field{border-color:#2c2c2c}
    .detail-field .field-label{color:#909399;flex-shrink:0;width:100px}
    .detail-field .field-value{color:#303133;font-weight:500;flex:1;text-align:right;word-break:break-all}
    html.dark .detail-field .field-value{color:#e5eaf3}
    .detail-tab-content{font-size:12px}
    .biz-desc-card{background:linear-gradient(135deg,#f0f7ff,#fafcff);border:1px solid #d9ecff;border-radius:10px;padding:12px 16px;margin-bottom:16px;display:flex;align-items:center;gap:10px}
    html.dark .biz-desc-card{background:#1a2a3c;border-color:#2a4a6c}
    .biz-desc-card i{color:#409EFF;font-size:16px;flex-shrink:0}
    .biz-desc-card span{font-size:13px;color:#606266;line-height:1.6}
    html.dark .biz-desc-card span{color:#c0c6d0}
    .top-tip-bar{background:linear-gradient(135deg,#ecf5ff,#f0f9eb);border:1px solid #d9ecff;border-radius:8px;padding:10px 16px;margin-bottom:12px;display:flex;align-items:center;gap:8px;font-size:13px;color:#409EFF}
    html.dark .top-tip-bar{background:#1a2a3c;border-color:#2a4a6c}
    .calibration-layout{display:flex;flex-direction:column;height:calc(100vh - var(--header-height) - 32px)}
    .calibration-header{background:#fff;border-radius:10px;padding:12px 16px;margin-bottom:12px;display:flex;align-items:center;gap:16px}
    html.dark .calibration-header{background:#1d1e1f}
    .calibration-body{display:flex;flex:1;gap:12px;overflow:hidden}
    .calibration-pdf{flex:1;background:#fff;border-radius:10px;overflow:hidden;display:flex;flex-direction:column}
    html.dark .calibration-pdf{background:#1d1e1f}
    .calibration-struct{flex:1;background:#fff;border-radius:10px;overflow:hidden;display:flex;flex-direction:column}
    html.dark .calibration-struct{background:#1d1e1f}
    .calibration-footer{background:#fff;border-radius:10px;padding:10px 16px;margin-top:12px;display:flex;align-items:center;justify-content:space-between}
    html.dark .calibration-footer{background:#1d1e1f}
    .pdf-preview{flex:1;background:#525659;display:flex;align-items:center;justify-content:center;position:relative;overflow:auto;padding:20px}
    .pdf-page{background:#fff;width:100%;max-width:600px;aspect-ratio:210/297;padding:40px;font-size:12px;line-height:1.8;position:relative;box-shadow:0 2px 12px rgba(0,0,0,.3)}
    .pdf-page .pdf-title{font-size:18px;font-weight:700;text-align:center;margin-bottom:16px;color:#303133}
    .pdf-page .pdf-heading2{font-size:14px;font-weight:700;margin:12px 0 6px;color:#303133}
    .pdf-page .pdf-para{text-indent:2em;margin-bottom:8px;color:#333}
    .pdf-page .pdf-highlight{background:rgba(64,158,255,.2);border-radius:2px;padding:0 2px}
    .struct-chapters{border-bottom:1px solid #ebeef5;padding:8px 12px;max-height:180px;overflow-y:auto}
    html.dark .struct-chapters{border-color:#363637}
    .struct-chapter-item{padding:4px 8px;font-size:12px;cursor:pointer;border-radius:4px;color:#606266;transition:var(--transition)}
    .struct-chapter-item:hover{background:#f0f5ff;color:var(--primary)}
    .struct-chapter-item.active{background:#ecf5ff;color:var(--primary);font-weight:600}
    html.dark .struct-chapter-item:hover{background:#262727}
    html.dark .struct-chapter-item.active{background:#1a3a5c}
    .struct-list{flex:1;overflow-y:auto;padding:12px}
    .struct-item{border:1px solid #ebeef5;border-radius:8px;padding:10px 12px;margin-bottom:8px;transition:var(--transition)}
    .struct-item:hover{border-color:var(--primary);background:#f0f7ff}
    html.dark .struct-item{border-color:#363637}
    html.dark .struct-item:hover{background:#1a3a5c;border-color:var(--primary)}
    .struct-item .struct-header{display:flex;align-items:center;gap:8px;margin-bottom:6px}
    .struct-item .struct-text{font-size:13px;color:#606266;line-height:1.6}
    html.dark .struct-item .struct-text{color:#cfd3dc}
    .struct-item .struct-actions{display:flex;gap:4px;margin-top:6px}
    .search-hero{text-align:center;padding:20px 20px 10px}
    .search-hero h2{font-size:28px;font-weight:900;margin-bottom:8px}
    .search-box{max-width:640px;margin:0 auto 20px}
    .search-tabs{display:flex;justify-content:center;gap:24px;margin-bottom:24px}
    .search-tab{font-size:14px;color:#909399;cursor:pointer;padding:6px 12px;border-radius:6px;transition:var(--transition)}
    .search-tab:hover{color:var(--primary)}
    .search-tab.active{color:var(--primary);font-weight:600;background:#ecf5ff}
    html.dark .search-tab.active{background:#1a3a5c}
    .search-facets{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-bottom:20px}
    .search-results{max-width:900px;margin:0 auto}
    .search-result-card{background:#fff;border-radius:10px;padding:16px;margin-bottom:12px;border:1px solid #ebeef5;transition:var(--transition)}
    html.dark .search-result-card{background:#1d1e1f;border-color:#363637}
    .search-result-card:hover{border-color:var(--primary);box-shadow:0 2px 12px rgba(64,158,255,.08)}
    .result-source{font-size:12px;color:#909399;margin-bottom:4px}
    .result-title{font-size:15px;font-weight:600;color:#303133;margin-bottom:6px}
    html.dark .result-title{color:#e5eaf3}
    .result-snippet{font-size:13px;color:#606266;line-height:1.7}
    html.dark .result-snippet{color:#cfd3dc}
    .result-meta{display:flex;gap:12px;margin-top:8px;font-size:12px;color:#909399}
    .result-actions{display:flex;gap:6px;margin-top:10px;padding-top:10px;border-top:1px dashed #ebeef5}
    html.dark .result-actions{border-color:#363637}
    .rag-container{display:flex;height:calc(100vh - var(--header-height) - 32px)}
    .rag-sidebar{width:280px;background:#fff;border-radius:10px;margin-right:12px;padding:16px;overflow-y:auto}
    html.dark .rag-sidebar{background:#1d1e1f}
    .rag-main{flex:1;background:#fff;border-radius:10px;display:flex;flex-direction:column;overflow:hidden}
    html.dark .rag-main{background:#1d1e1f}
    .chat-messages{flex:1;overflow-y:auto;padding:20px}
    .chat-msg{display:flex;gap:12px;margin-bottom:16px}
    .chat-msg.user{flex-direction:row-reverse}
    .chat-msg .msg-avatar{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:16px}
    .chat-msg .msg-bubble{max-width:70%;padding:12px 16px;border-radius:12px;font-size:13px;line-height:1.7}
    .chat-msg.assistant .msg-bubble{background:#f4f6f8;color:#303133}
    .chat-msg.user .msg-bubble{background:var(--primary);color:#fff}
    html.dark .chat-msg.assistant .msg-bubble{background:#2c2c2c;color:#e5eaf3}
    .citation-card{background:#f0f7ff;border:1px solid #d9ecff;border-radius:8px;padding:8px 12px;margin-top:8px;font-size:12px;color:#409EFF;cursor:pointer;transition:var(--transition)}
    .citation-card:hover{background:#d9ecff}
    html.dark .citation-card{background:#1a3a5c;border-color:#2a5a8c}
    html.dark .citation-card:hover{background:#2a4a6c}
    .chat-input{padding:16px;border-top:1px solid #ebeef5;display:flex;gap:8px}
    html.dark .chat-input{border-color:#363637}
    .rag-process{display:flex;align-items:center;gap:8px;padding:8px 16px;background:#f4f6f8;border-radius:8px;font-size:12px;color:#606266;margin-bottom:12px}
    html.dark .rag-process{background:#2c2c2c;color:#c0c6d0}
    .rag-process .dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#409EFF;animation:pulse 1s infinite}
    @keyframes pulse{0%,100%{opacity:.3}50%{opacity:1}}
    .retrieval-evidence{background:#f9fafb;border:1px solid #e4e7eb;border-radius:10px;margin-top:12px;padding:14px 16px;font-size:12px}
    html.dark .retrieval-evidence{background:#252728;border-color:#3a3c3d}
    .retrieval-evidence .ev-title{font-weight:700;font-size:13px;color:#303133;margin-bottom:10px;display:flex;align-items:center;gap:6px}
    html.dark .retrieval-evidence .ev-title{color:#e5eaf3}
    .retrieval-evidence .ev-field{display:flex;gap:8px;margin-bottom:6px;color:#606266}
    html.dark .retrieval-evidence .ev-field{color:#c0c6d0}
    .retrieval-evidence .ev-field .ev-label{width:80px;color:#909399;flex-shrink:0}
    .retrieval-evidence .ev-table{width:100%;border-collapse:collapse;margin-top:8px}
    .retrieval-evidence .ev-table th{background:#f0f2f5;padding:4px 8px;text-align:left;font-weight:600;font-size:11px;color:#606266;border:1px solid #e8e8e8}
    .retrieval-evidence .ev-table td{padding:4px 8px;font-size:11px;color:#606266;border:1px solid #e8e8e8}
    html.dark .retrieval-evidence .ev-table th{background:#2c2c2c;border-color:#3a3a3a;color:#a3a6ad}
    html.dark .retrieval-evidence .ev-table td{border-color:#3a3a3a;color:#a3a6ad}
    .upload-zone{border:2px dashed #dcdfe6;border-radius:12px;padding:40px 20px;text-align:center;transition:var(--transition);cursor:pointer}
    .upload-zone:hover{border-color:var(--primary);background:#f0f7ff}
    html.dark .upload-zone:hover{background:#1a3a5c}
    .upload-zone i{font-size:48px;color:#c0c4cc;margin-bottom:12px}
    .upload-zone .upload-text{font-size:14px;color:#606266}
    .upload-zone .upload-hint{font-size:12px;color:#909399;margin-top:8px}
    .chart-card{background:#fff;border-radius:12px;padding:20px;border:1px solid #ebeef5}
    html.dark .chart-card{background:#1d1e1f;border-color:#363637}
    .chart-card .chart-title{font-size:15px;font-weight:600;color:#303133;margin-bottom:16px}
    html.dark .chart-card .chart-title{color:#e5eaf3}
    .risk-card{background:#fff;border-radius:10px;padding:16px;border:1px solid #ebeef5;cursor:pointer;transition:var(--transition)}
    html.dark .risk-card{background:#1d1e1f;border-color:#363637}
    .risk-card:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.1)}
    .risk-card.active{border-color:var(--primary);background:#f0f7ff}
    html.dark .risk-card.active{background:#1a3a5c}
    .risk-card .rc-value{font-size:24px;font-weight:900}
    .risk-card .rc-label{font-size:12px;color:#909399;margin-top:2px}
    .org-card{background:#fff;border-radius:10px;padding:16px;border:1px solid #ebeef5;text-align:center}
    html.dark .org-card{background:#1d1e1f;border-color:#363637}
    .org-card .oc-name{font-size:13px;font-weight:600;color:#303133;margin-bottom:8px}
    html.dark .org-card .oc-name{color:#e5eaf3}
    .org-card .oc-stat{display:flex;justify-content:space-around}
    .org-card .oc-stat .oc-num{font-size:20px;font-weight:800;color:#409EFF}
    .org-card .oc-stat .oc-lbl{font-size:11px;color:#909399}
    .page-title{font-size:18px;font-weight:700;color:#303133;margin-bottom:8px;display:flex;align-items:center;gap:8px}
    html.dark .page-title{color:#e5eaf3}
    .mb-8{margin-bottom:8px}.mb-12{margin-bottom:12px}.mb-16{margin-bottom:16px}.mb-20{margin-bottom:20px}.mt-12{margin-top:12px}
    .flex-between{display:flex;align-items:center;justify-content:space-between}
    .flex-center{display:flex;align-items:center;justify-content:center}
    .text-primary{color:var(--primary)}.text-success{color:var(--success)}.text-warning{color:var(--warning)}.text-danger{color:var(--danger)}
    .caliber-note{font-size:11px;color:#909399;margin-top:4px;display:inline-flex;align-items:center;gap:4px}
    .status-tag{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:500}
    .status-uploaded{background:#f0f5ff;color:#409EFF}.status-checking{background:#fdf6ec;color:#E6A23C}.status-pending{background:#fef0f0;color:#F56C6C}
    .status-registered{background:#f0f9eb;color:#67C23A}.status-structuring{background:#fdf6ec;color:#E6A23C}.status-calibrating{background:#f0f5ff;color:#409EFF}
    .status-stored{background:#f0f9eb;color:#67C23A}.status-indexed{background:#ecf5ff;color:#337ECC}.status-auditing{background:#fdf6ec;color:#E6A23C}
    .maturity-badge{display:inline-flex;align-items:center;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:600}
    .maturity-L0{background:#f5f5f5;color:#909399}.maturity-L1{background:#ecf5ff;color:#409EFF}.maturity-L2{background:#f0f9eb;color:#67C23A}
    .maturity-L3{background:#fdf6ec;color:#E6A23C}.maturity-L4{background:#fef0f0;color:#F56C6C}
    .api-group{margin-bottom:20px}
    .api-group-title{font-size:14px;font-weight:700;color:#303133;margin-bottom:8px;display:flex;align-items:center;gap:8px}
    html.dark .api-group-title{color:#e5eaf3}
    ::-webkit-scrollbar{width:6px;height:6px}
    ::-webkit-scrollbar-thumb{background:#c0c4cc;border-radius:3px}
    ::-webkit-scrollbar-track{background:transparent}
    ::-webkit-scrollbar-thumb:hover{background:#909399}
    .fade-enter-active,.fade-leave-active{transition:opacity .2s ease}
    .fade-enter-from,.fade-leave-to{opacity:0}
    @media(max-width:1200px){.catalog-left{width:200px}.catalog-right.open{width:400px}}
    @media(max-width:768px){.catalog-left{display:none}.catalog-right.open{width:100%;position:absolute;right:0;top:0;bottom:0;z-index:50}}
    html.dark{color-scheme:dark}
  </style>
</head>
<body>
  <div id="app">
    <div class="app-container">
      <header class="app-header" :class="{dark:isDark}" style="position:relative">
        <div class="header-left">
          <div class="header-logo"><i class="fa-solid fa-database"></i><span>知识数据中台</span></div>
          <div class="header-search">
            <el-input v-model="globalSearch" placeholder="搜索资源名称、ISBN、作者、关键词..." size="default" clearable @keyup.enter="onGlobalSearchEnter">
              <template #prefix><i class="fa-solid fa-magnifying-glass" style="color:rgba(255,255,255,.5)"></i></template>
            </el-input>
          </div>
        </div>
        <div class="header-right">
          <div class="header-btn" @click="toggleTheme" :title="isDark?'切换亮色':'切换暗色'"><i :class="isDark?'fa-solid fa-sun':'fa-solid fa-moon'"></i></div>
          <div class="header-btn" @click="notifPanelOpen=!notifPanelOpen" title="通知">
            <el-badge :value="unreadNotifCount" :max="99" :hidden="unreadNotifCount===0"><i class="fa-solid fa-bell"></i></el-badge>
          </div>
          <el-dropdown trigger="click">
            <div class="header-user"><el-avatar :size="32" style="background:#409EFF">治</el-avatar><span style="font-size:13px">数据治理管理员</span><i class="fa-solid fa-chevron-down" style="font-size:10px"></i></div>
            <template #dropdown><el-dropdown-menu><el-dropdown-item @click="currentPage='sec-audit'">操作日志</el-dropdown-item><el-dropdown-item divided>退出登录</el-dropdown-item></el-dropdown-menu></template>
          </el-dropdown>
        </div>
        <transition name="fade">
          <div v-if="notifPanelOpen" class="notif-panel" @click.stop>
            <div class="notif-header"><span class="nh-title"><i class="fa-solid fa-bell" style="margin-right:6px;color:#409EFF"></i>通知中心</span><el-button text size="small" @click="markAllRead">全部已读</el-button></div>
            <div class="notif-list">
              <div v-if="store.notifications.length===0" class="notif-empty"><i class="fa-solid fa-check-double" style="font-size:28px;display:block;margin-bottom:8px;color:#67C23A"></i>暂无通知</div>
              <div v-for="n in store.notifications" :key="n.id" class="notif-item" :class="{read:n.read}" @click="handleNotifClick(n)">
                <div class="ni-icon" :style="{background:n.color}"><i :class="n.icon"></i></div>
                <div class="ni-body"><div class="ni-text">{{ n.text }}</div><div class="ni-time">{{ n.time }}</div></div>
              </div>
            </div>
          </div>
        </transition>
      </header>

      <div class="app-body">
        <aside class="app-sidebar" :class="{collapsed:sidebarCollapsed}">
          <div class="sidebar-logo" @click="sidebarCollapsed=!sidebarCollapsed">
            <i class="fa-solid fa-layer-group logo-icon"></i><span class="logo-text menu-text" v-show="!sidebarCollapsed">功能导航</span>
            <i v-show="!sidebarCollapsed" :class="sidebarCollapsed?'fa-solid fa-chevron-right':'fa-solid fa-chevron-left'" style="font-size:10px;color:#909399;margin-left:auto"></i>
          </div>
          <el-menu :default-active="currentPage" :collapse="sidebarCollapsed" :collapse-transition="true" @select="handleMenuSelect" style="border-right:none">
            <el-menu-item index="dashboard"><i class="fa-solid fa-chart-pie"></i><span class="menu-text">总览大屏</span></el-menu-item>
            <el-sub-menu index="assets"><template #title><i class="fa-solid fa-box-archive"></i><span class="menu-text">数据资产</span></template><el-menu-item index="asset-catalog">资产目录</el-menu-item><el-menu-item index="asset-enrollment">资产编目</el-menu-item><el-menu-item index="asset-standards">分级分类</el-menu-item><el-menu-item index="asset-tags">标签体系</el-menu-item></el-sub-menu>
            <el-sub-menu index="resources"><template #title><i class="fa-solid fa-cloud-arrow-up"></i><span class="menu-text">资源管理</span></template><el-menu-item index="resource-upload">资源接入</el-menu-item><el-menu-item index="resource-original">原始资源库</el-menu-item><el-menu-item index="resource-struct">成果库</el-menu-item></el-sub-menu>
            <el-sub-menu index="struct"><template #title><i class="fa-solid fa-book-open"></i><span class="menu-text">内容结构化</span></template><el-menu-item index="struct-parse">解析引擎</el-menu-item><el-menu-item index="struct-calibrate">校准工作台</el-menu-item><el-menu-item index="struct-audit">结构化审核</el-menu-item><el-menu-item index="struct-results">结构化成果</el-menu-item></el-sub-menu>
            <el-sub-menu index="search"><template #title><i class="fa-solid fa-magnifying-glass-chart"></i><span class="menu-text">知识检索</span></template><el-menu-item index="search-fulltext">全文检索</el-menu-item><el-menu-item index="search-semantic">语义检索</el-menu-item><el-menu-item index="search-faceted">分面导航</el-menu-item><el-menu-item index="search-hybrid">混合检索</el-menu-item></el-sub-menu>
            <el-sub-menu index="ai"><template #title><i class="fa-solid fa-robot"></i><span class="menu-text">AI 与 RAG</span></template><el-menu-item index="ai-rag">RAG 问答</el-menu-item><el-menu-item index="ai-models">模型网关</el-menu-item><el-menu-item index="ai-agent">Agent 工作台</el-menu-item><el-menu-item index="ai-prompts">提示词库</el-menu-item></el-sub-menu>
            <el-sub-menu index="governance"><template #title><i class="fa-solid fa-sitemap"></i><span class="menu-text">数据治理</span></template><el-menu-item index="gov-metadata">元数据管理</el-menu-item><el-menu-item index="gov-quality">数据质量</el-menu-item><el-menu-item index="gov-lineage">血缘分析</el-menu-item><el-menu-item index="gov-copyright">版权授权</el-menu-item></el-sub-menu>
            <el-sub-menu index="security"><template #title><i class="fa-solid fa-shield-halved"></i><span class="menu-text">安全合规</span></template><el-menu-item index="sec-permission">权限管理</el-menu-item><el-menu-item index="sec-audit">审计日志</el-menu-item><el-menu-item index="sec-alert">异常预警</el-menu-item></el-sub-menu>
            <el-sub-menu index="api"><template #title><i class="fa-solid fa-plug"></i><span class="menu-text">接口服务</span></template><el-menu-item index="api-gateway">数据网关</el-menu-item><el-menu-item index="api-callback">成果回流</el-menu-item><el-menu-item index="api-feedback">运营反馈回流</el-menu-item></el-sub-menu>
            <el-menu-item index="settings"><i class="fa-solid fa-gear"></i><span class="menu-text">系统设置</span></el-menu-item>
          </el-menu>
        </aside>

        <main class="app-main" @click="notifPanelOpen=false">
          <!-- Dashboard -->
          <div v-if="currentPage==='dashboard'">
            <div class="page-title"><i class="fa-solid fa-chart-pie text-primary"></i> 总览大屏</div>
            <div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>知识数据中台运营数据概览，展示从资源接入到API服务输出的全链路运转状态。</span></div>
            <div class="flow-overview">
              <div class="flow-title"><i class="fa-solid fa-route text-primary"></i> 数据中台流转总览（点击节点跳转）</div>
              <div class="flow-main">
                <div class="flow-node" @click="currentPage='resource-upload'"><div class="node-label">资源接入</div><div class="node-value">{{ store.overview.resourceIngested.toLocaleString() }}</div><div class="node-sub">累计接入</div></div>
                <i class="fa-solid fa-arrow-right flow-arrow"></i>
                <div class="flow-node" @click="currentPage='gov-copyright'"><div class="node-label">元数据治理·含版权确权</div><div class="node-value">{{ store.overview.authorized }}</div><div class="node-sub">已确权</div></div>
                <i class="fa-solid fa-arrow-right flow-arrow"></i>
                <div class="flow-node" @click="currentPage='struct-parse'"><div class="node-label">结构化解析</div><div class="node-value">{{ structuredBookCount }}</div><div class="node-sub">已结构化图书</div></div>
                <i class="fa-solid fa-arrow-right flow-arrow"></i>
                <div class="flow-node" @click="currentPage='resource-struct'"><div class="node-label">知识库入库</div><div class="node-value">{{ store.overview.knowledgeFragments.toLocaleString() }}</div><div class="node-sub">知识片段 / 向量索引 {{ store.overview.vectorIndex.toLocaleString() }}</div></div>
                <i class="fa-solid fa-arrow-right flow-arrow"></i>
                <div class="flow-node" @click="currentPage='ai-rag'"><div class="node-label">检索·RAG问答</div><div class="node-value">{{ store.ragCallCount.toLocaleString() }}</div><div class="node-sub">今日调用</div></div>
                <i class="fa-solid fa-arrow-right flow-arrow"></i>
                <div class="flow-node" @click="currentPage='api-gateway'"><div class="node-label">API服务输出</div><div class="node-value">{{ store.overview.openApis }}</div><div class="node-sub">开放接口</div></div>
              </div>
              <div class="flow-audit" @click="currentPage='sec-audit'"><i class="fa-solid fa-shield-halved" style="margin-right:6px"></i> 安全合规 · 权限校验 · 操作审计（Append-Only）— 横贯全链路（点击查看审计日志）</div>
            </div>
            <el-row :gutter="16" class="mb-20">
              <el-col :span="6" v-for="(stat,idx) in dashboardStats" :key="idx"><div class="stat-card" @click="drillDownStat(stat)"><div class="stat-icon" :style="{background:stat.color}"><i :class="stat.icon"></i></div><div class="stat-value">{{ stat.value }}</div><div class="stat-label">{{ stat.label }}</div><div class="stat-trend" :class="stat.trendUp?'text-success':'text-danger'"><i :class="stat.trendUp?'fa-solid fa-arrow-up':'fa-solid fa-arrow-down'"></i> {{ stat.trend }}</div><div class="stat-bg"><i :class="stat.icon"></i></div><div class="stat-drill"><i class="fa-solid fa-arrow-up-right-from-square"></i> 点击下钻</div></div></el-col>
            </el-row>
            <el-row :gutter="16" class="mb-16"><el-col :span="12"><div class="chart-card"><div class="chart-title">资源接入趋势</div><div id="chart-trend" style="height:280px"></div></div></el-col><el-col :span="12"><div class="chart-card"><div class="chart-title">各专题库资源分布</div><div id="chart-distribution" style="height:280px"></div></div></el-col></el-row>
            <el-row :gutter="16"><el-col :span="8"><div class="chart-card"><div class="chart-title">加工状态分布</div><div id="chart-status" style="height:240px"></div></div></el-col><el-col :span="8"><div class="chart-card"><div class="chart-title">数据成熟度分布</div><div id="chart-quality" style="height:240px"></div></div></el-col><el-col :span="8"><div class="chart-card"><div class="chart-title">本周检索热词</div><div id="chart-keywords" style="height:240px"></div></div></el-col></el-row>
          </div>

          <!-- Asset Catalog -->
          <div v-if="currentPage==='asset-catalog'" style="height:100%">
            <div class="catalog-layout">
              <div class="catalog-left"><div style="font-size:13px;font-weight:600;color:#303133;margin-bottom:12px;display:flex;align-items:center;gap:6px"><i class="fa-solid fa-folder-tree text-primary"></i> 专题库导航</div><div class="topic-tree"><div v-for="topic in topics" :key="topic.id" class="topic-node" :class="{active:activeTopic===topic.id}" @click="activeTopic=topic.id"><i :class="topic.icon" class="topic-icon" :style="{color:topic.color}"></i><span class="topic-name">{{ topic.name }}</span><span class="topic-count">{{ topic.count }}</span></div></div></div>
              <div class="catalog-center">
                <div class="biz-desc-card" style="margin:8px 0 0 12px"><i class="fa-solid fa-circle-info"></i><span>统一管理图书、专题资料、图片、音视频等内容资源，形成可检索、可授权、可追溯的内容资产台账。</span></div>
                <div class="asset-toolbar">
                  <el-input v-model="assetSearch" placeholder="搜索资产..." size="small" style="width:200px" clearable><template #prefix><i class="fa-solid fa-magnifying-glass" style="color:#909399"></i></template></el-input>
                  <el-select v-model="filterType" size="small" placeholder="资源类型" clearable style="width:120px"><el-option v-for="t in resourceTypes" :key="t" :label="t" :value="t"></el-option></el-select>
                  <el-select v-model="filterStatus" size="small" placeholder="加工状态" clearable style="width:120px"><el-option v-for="s in processStatuses" :key="s" :label="s" :value="s"></el-option></el-select>
                  <el-select v-model="filterMaturity" size="small" placeholder="成熟度" clearable style="width:100px"><el-option v-for="q in maturityOptions" :key="q.val" :label="q.label" :value="q.val"></el-option></el-select>
                  <div style="margin-left:auto;display:flex;gap:4px"><el-button :type="viewMode==='card'?'primary':''" size="small" @click="viewMode='card'"><i class="fa-solid fa-grip"></i></el-button><el-button :type="viewMode==='table'?'primary':''" size="small" @click="viewMode='table'"><i class="fa-solid fa-list"></i></el-button></div>
                </div>
                <div class="asset-list" v-if="viewMode==='card'">
                  <div v-for="asset in filteredAssets" :key="asset.id" class="asset-card" :class="{active:selectedAsset&&selectedAsset.id===asset.id}" @click="selectAsset(asset)"><div class="asset-type-icon" :style="{background:asset.typeColor}"><i :class="asset.typeIcon" style="color:#fff"></i></div><div class="asset-info"><div class="asset-name">{{ asset.name }}</div><div class="asset-meta"><span><i class="fa-solid fa-barcode"></i> {{ asset.isbn||asset.code }}</span><span><i class="fa-regular fa-clock"></i> {{ asset.updatedAt }}</span></div><div class="asset-tags"><span :class="'status-tag status-'+asset.statusKey">{{ asset.statusLabel }}</span><span :class="'maturity-badge maturity-'+asset.maturityLevel">成熟度：{{ asset.maturityLevel }}</span><el-tag v-for="tag in asset.tags" :key="tag" size="small" type="info" effect="plain" round>{{ tag }}</el-tag></div></div></div>
                </div>
                <div class="asset-list" v-else style="padding:0">
                  <el-table :data="filteredAssets" stripe highlight-current-row @row-click="selectAsset" style="width:100%" size="small">
                    <el-table-column prop="name" label="资源名称" min-width="180"><template #default="{row}"><div style="font-weight:600;color:#303133">{{ row.name }}</div></template></el-table-column>
                    <el-table-column prop="type" label="类型" width="80"/><el-table-column prop="isbn" label="ISBN/编号" width="140"/>
                    <el-table-column label="加工状态" width="90"><template #default="{row}"><span :class="'status-tag status-'+row.statusKey">{{ row.statusLabel }}</span></template></el-table-column>
                    <el-table-column label="成熟度" width="80"><template #default="{row}"><span :class="'maturity-badge maturity-'+row.maturityLevel">{{ row.maturityLevel }}</span></template></el-table-column>
                    <el-table-column prop="updatedAt" label="更新时间" width="110"/>
                  </el-table>
                </div>
              </div>
              <div class="catalog-right" :class="{open:selectedAsset}">
                <div class="detail-panel" v-if="selectedAsset">
                  <div class="detail-header"><div class="detail-title">{{ selectedAsset.name }}</div><el-button text @click="selectedAsset=null"><i class="fa-solid fa-xmark"></i></el-button></div>
                  <el-tabs v-model="detailTab" type="border-card" style="font-size:12px">
                    <el-tab-pane label="出版元数据" name="meta"><div class="detail-tab-content">
                      <div class="detail-field"><span class="field-label">书名</span><span class="field-value">{{ selectedAsset.name }}</span></div>
                      <div class="detail-field"><span class="field-label">ISBN</span><span class="field-value">{{ selectedAsset.isbn||'-' }}</span></div>
                      <div class="detail-field"><span class="field-label">CIP</span><span class="field-value">{{ selectedAsset.cip||'-' }}</span></div>
                      <div class="detail-field"><span class="field-label">作者/主编</span><span class="field-value">{{ selectedAsset.author||'-' }}</span></div>
                      <div class="detail-field"><span class="field-label">责任编辑</span><span class="field-value">{{ selectedAsset.editor||'-' }}</span></div>
                      <div class="detail-field"><span class="field-label">出版时间</span><span class="field-value">{{ selectedAsset.pubDate||'-' }}</span></div>
                      <div class="detail-field"><span class="field-label">中图分类号</span><span class="field-value">{{ selectedAsset.clc||'-' }}</span></div>
                      <div class="detail-field"><span class="field-label">所属专题</span><span class="field-value">{{ selectedAsset.topic }}</span></div>
                      <div class="detail-field"><span class="field-label">关键词</span><span class="field-value">{{ (selectedAsset.tags||[]).join('、') }}</span></div>
                      <div class="detail-field"><span class="field-label">摘要</span><span class="field-value">{{ selectedAsset.abstract_||'-' }}</span></div>
                    </div></el-tab-pane>
                    <el-tab-pane label="版权授权" name="copyright"><div class="detail-tab-content">
                      <div class="detail-field"><span class="field-label">版权归属</span><span class="field-value">{{ selectedAsset.copyrightOwner||'-' }}</span></div>
                      <div class="detail-field"><span class="field-label">合同编号</span><span class="field-value">{{ selectedAsset.contractNo||'-' }}</span></div>
                      <div class="detail-field"><span class="field-label">授权期限</span><span class="field-value">{{ selectedAsset.authPeriod||'-' }}</span></div>
                      <div class="detail-field"><span class="field-label">可AI问答</span><span class="field-value"><el-tag size="small" :type="selectedAsset.aiQA?'success':'danger'">{{ selectedAsset.aiQA?'允许':'禁止' }}</el-tag></span></div>
                      <div class="detail-field"><span class="field-label">可模型训练</span><span class="field-value"><el-tag size="small" :type="selectedAsset.training?'success':'danger'">{{ selectedAsset.training?'允许':'禁止' }}</el-tag></span></div>
                      <div class="detail-field"><span class="field-label">可对外交付</span><span class="field-value"><el-tag size="small" :type="selectedAsset.delivery?'success':'danger'">{{ selectedAsset.delivery?'允许':'禁止' }}</el-tag></span></div>
                      <div class="detail-field"><span class="field-label">授权风险</span><span class="field-value"><el-tag size="small" :type="selectedAsset.authRisk==='低'?'success':selectedAsset.authRisk==='中'?'warning':'danger'">{{ selectedAsset.authRisk||'低' }}</el-tag></span></div>
                    </div></el-tab-pane>
                    <el-tab-pane label="结构化状态" name="struct"><div class="detail-tab-content">
                      <div class="detail-field"><span class="field-label">章节数</span><span class="field-value">{{ selectedAsset.chapters||'-' }}</span></div>
                      <div class="detail-field"><span class="field-label">段落数</span><span class="field-value">{{ selectedAsset.paragraphs||'-' }}</span></div>
                      <div class="detail-field"><span class="field-label">知识片段</span><span class="field-value">{{ selectedAsset.fragments||'-' }}</span></div>
                      <div class="detail-field"><span class="field-label">ES索引</span><span class="field-value"><el-tag size="small" :type="selectedAsset.esIndexed?'success':'info'">{{ selectedAsset.esIndexed?'已索引':'未建立' }}</el-tag></span></div>
                      <div class="detail-field"><span class="field-label">成果版本</span><span class="field-value">{{ selectedAsset.version||'-' }}</span></div>
                    </div></el-tab-pane>
                    <el-tab-pane label="调用与审计" name="audit"><div class="detail-tab-content">
                      <div class="detail-field"><span class="field-label">检索次数</span><span class="field-value">{{ selectedAsset.searchCount||0 }}</span></div>
                      <div class="detail-field"><span class="field-label">RAG调用</span><span class="field-value">{{ selectedAsset.ragCount||0 }}</span></div>
                      <div class="detail-field"><span class="field-label">API调用</span><span class="field-value">{{ selectedAsset.apiCount||0 }}</span></div>
                    </div></el-tab-pane>
                  </el-tabs>
                  <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap">
                    <el-button type="primary" size="small" @click="onPushToPlatform"><i class="fa-solid fa-paper-plane"></i> 推送至加工平台</el-button>
                    <el-button size="small" @click="openStructResultFromAsset"><i class="fa-solid fa-eye"></i> 结构化成果</el-button>
                    <el-button size="small" @click="openEditMetaDialog"><i class="fa-solid fa-pen"></i> 编辑元数据</el-button>
                    <el-button size="small" @click="openEditAuthDialog(selectedAsset)"><i class="fa-solid fa-key"></i> 管理授权</el-button>
                    <el-button size="small" @click="onDownloadOriginal"><i class="fa-solid fa-download"></i> 下载原件</el-button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Asset Enrollment -->
          <div v-if="currentPage==='asset-enrollment'">
            <div class="page-title"><i class="fa-solid fa-clipboard-list text-primary"></i> 资产编目</div>
            <div style="font-size:13px;color:#909399;margin-bottom:12px">待补全书目元数据、版权信息与资产状态，完成后提交审批进入资产目录。</div>
            <!-- 顶部统计卡片 -->
            <el-row :gutter="12" style="margin-bottom:16px">
              <el-col :span="6"><div class="enroll-stat-card" :class="{clickable:enrollmentStats.missingMeta>0}" @click="showToast('已筛选待补全元数据资源','info')"><div class="enroll-stat-num" style="color:#E6A23C">{{ enrollmentStats.missingMeta }}</div><div class="enroll-stat-label">待补全元数据</div></div></el-col>
              <el-col :span="6"><div class="enroll-stat-card" :class="{clickable:enrollmentStats.pendingCopyright>0}" @click="showToast('已筛选待版权确认资源','info')"><div class="enroll-stat-num" style="color:#F56C6C">{{ enrollmentStats.pendingCopyright }}</div><div class="enroll-stat-label">待版权确认</div></div></el-col>
              <el-col :span="6"><div class="enroll-stat-card" :class="{clickable:enrollmentStats.pendingSubmit>0}" @click="showToast('已筛选待提交审批资源','info')"><div class="enroll-stat-num" style="color:#409EFF">{{ enrollmentStats.pendingSubmit }}</div><div class="enroll-stat-label">待提交审批</div></div></el-col>
              <el-col :span="6"><div class="enroll-stat-card"><div class="enroll-stat-num" style="color:#67C23A">{{ enrollmentStats.todayDone }}</div><div class="enroll-stat-label">今日完成编目</div></div></el-col>
            </el-row>
            <el-card>
              <div class="flex-between mb-16"><div style="display:flex;gap:8px"><el-button type="primary" size="small" @click="showToast('新增编目草稿已创建','info')"><i class="fa-solid fa-plus"></i> 新增编目</el-button><el-button size="small" @click="showToast('已下载导入模板','success')"><i class="fa-solid fa-download"></i> 导出模板</el-button></div><el-input size="small" placeholder="搜索资源名称、编码或ISBN..." style="width:240px" clearable/></div>
              <el-alert v-if="enrollmentIssues.length" type="warning" :closable="false" style="margin-bottom:12px"><template #title><b>编目问题提示（{{ enrollmentIssues.length }}项）</b></template><div v-for="(issue,i) in enrollmentIssues" :key="i" style="font-size:12px;color:#E6A23C"><i class="fa-solid fa-triangle-exclamation" style="margin-right:4px"></i>{{ issue }}</div></el-alert>
              <el-table :data="enrollmentData" stripe size="small" @row-click="selectEnrollment" highlight-current-row>
                <el-table-column prop="name" label="资源名称" min-width="140"><template #default="{row}"><el-tooltip :content="row.name" placement="top" :disabled="row.name.length<15"><div style="font-size:13px;font-weight:500;color:#303133;line-height:1.4">{{ row.name }}</div><div style="font-size:11px;color:#909399">{{ row.code }}</div></el-tooltip></template></el-table-column>
                <el-table-column prop="code" label="资产编码" width="110"/>
                <el-table-column prop="type" label="资源类型" width="80"><template #default="{row}"><el-tag size="small" type="info">{{ row.type }}</el-tag></template></el-table-column>
                <el-table-column label="ISBN/CIP" width="100"><template #default="{row}"><span v-if="row.isbn" style="font-size:12px;color:#67C23A"><i class="fa-solid fa-check" style="margin-right:2px"></i>已补全</span><span v-else style="font-size:12px;color:#F56C6C"><i class="fa-solid fa-circle-exclamation" style="margin-right:2px"></i>缺ISBN</span><div v-if="row.cip==='缺失'" style="font-size:11px;color:#F56C6C;margin-top:2px">缺CIP</div></template></el-table-column>
                <el-table-column prop="editor" label="责任编辑" width="90"/>
                <el-table-column prop="copyrightStatus" label="版权状态" width="85"><template #default="{row}"><el-tag size="small" :type="row.copyrightStatus==='已确认'?'success':row.copyrightStatus==='有风险'?'danger':'warning'">{{ row.copyrightStatus }}</el-tag></template></el-table-column>
                <el-table-column prop="completeness" label="完整率" width="90"><template #default="{row}"><el-progress :percentage="row.completeness" :stroke-width="8" :color="row.completeness>=80?'#67C23A':row.completeness>=50?'#E6A23C':'#F56C6C"/></template></el-table-column>
                <el-table-column prop="status" label="当前状态" width="85"><template #default="{row}"><el-tag size="small" :type="row.status==='已发布'?'success':row.status==='待审批'?'primary':row.status==='驳回'?'danger':'warning'">{{ row.status }}</el-tag></template></el-table-column>
                <el-table-column label="下一步" width="95"><template #default="{row}"><el-button link size="small" :type="row.nextAction==='补全信息'||row.nextAction==='确认版权'?'warning':'primary'" @click="handleNextAction(row)">{{ row.nextAction }}</el-button></template></el-table-column>
              </el-table>
            </el-card>
            <!-- 右侧资源详情（5区） -->
            <el-card v-if="selectedEnrollment" style="margin-top:16px"><template #header><div class="flex-between"><span style="font-weight:600"><i class="fa-solid fa-circle-info" style="margin-right:6px;color:#409EFF"></i>{{ selectedEnrollment.name }} · 资源详情</span><el-button link type="danger" size="small" @click="selectedEnrollment=null"><i class="fa-solid fa-times"></i></el-button></div></template>
              <el-row :gutter="16">
                <el-col :span="12">
                  <!-- 区域一：资产状态 -->
                  <el-card shadow="never" class="mb-12"><template #header><span class="detail-section-title"><i class="fa-solid fa-circle-check" style="color:#67C23A;margin-right:4px"></i>当前资产状态</span></template>
                    <div class="detail-row"><span class="detail-label">当前阶段</span><el-tag size="small" :type="selectedEnrollment.status==='已发布'?'success':selectedEnrollment.status==='待审批'?'primary':'warning'">{{ selectedEnrollment.status }}</el-tag></div>
                    <div class="detail-row"><span class="detail-label">编目完整率</span><span :style="{fontWeight:700,color:selectedEnrollment.completeness>=80?'#67C23A':selectedEnrollment.completeness>=50?'#E6A23C':'#F56C6C'}">{{ selectedEnrollment.completeness }}%</span></div>
                    <div class="detail-row"><span class="detail-label">是否可提交审批</span><span :style="{fontWeight:600,color:selectedEnrollment.completeness>=60?'#67C23A':'#F56C6C'}">{{ selectedEnrollment.completeness>=60?'是':'否' }}</span></div>
                    <div v-if="selectedEnrollment.completeness<60" class="detail-row"><span class="detail-label">不可提交原因</span><span style="color:#F56C6C">{{!selectedEnrollment.isbn?'ISBN缺失；':''}}{{selectedEnrollment.copyrightStatus!=='已确认'?'版权状态待确认；':'去补全'}}</span></div>
                    <div class="detail-row"><span class="detail-label">下一步建议</span><span style="color:#409EFF;font-weight:500">{{!selectedEnrollment.isbn?'补全ISBN并':'去补全'}}{{selectedEnrollment.copyrightStatus!=='已确认'?'确认版权授权':'提交审批'}}</span></div>
                  </el-card>
                  <!-- 区域三：版权与授权 -->
                  <el-card shadow="never" class="mb-12"><template #header><span class="detail-section-title"><i class="fa-solid fa-shield-halved" style="color:#E6A23C;margin-right:4px"></i>版权与授权信息</span></template>
                    <div v-for="item in enrollmentAuthItems" :key="item.name" class="detail-row">
                      <span class="detail-label">{{ item.name }}</span>
                      <span v-if="item.status==='已允许'" style="color:#67C23A;font-weight:500"><i class="fa-solid fa-check-circle" style="margin-right:3px"></i>已允许</span>
                      <span v-else-if="item.status==='待确认'" style="color:#E6A23C;font-weight:500"><i class="fa-solid fa-question-circle" style="margin-right:3px"></i>待确认</span>
                      <span v-else-if="item.status==='不允许'" style="color:#F56C6C;font-weight:500"><i class="fa-solid fa-ban" style="margin-right:3px"></i>不允许</span>
                      <span v-else style="color:#303133;font-weight:500">{{ item.value }}</span>
                    </div>
                  </el-card>
                </el-col>
                <el-col :span="12">
                  <!-- 区域二：基础出版信息 -->
                  <el-card shadow="never" class="mb-12"><template #header><span class="detail-section-title"><i class="fa-solid fa-book" style="color:#409EFF;margin-right:4px"></i>基础出版信息</span></template>
                    <div class="detail-row"><span class="detail-label">资产编码</span><span>{{ selectedEnrollment.code }}</span></div>
                    <div class="detail-row"><span class="detail-label">ISBN</span><span :style="{color:selectedEnrollment.isbn?'#303133':'#F56C6C'}">{{ selectedEnrollment.isbn||'缺失，待补全' }}</span></div>
                    <div class="detail-row"><span class="detail-label">CIP</span><span :style="{color:selectedEnrollment.cip!=='缺失'?'#303133':'#F56C6C'}">{{ selectedEnrollment.cip==='缺失'?'缺失':selectedEnrollment.cip }}</span></div>
                    <div class="detail-row"><span class="detail-label">书名</span><span style="font-weight:500">《{{ selectedEnrollment.name }}》</span></div>
                    <div class="detail-row"><span class="detail-label">作者/主编</span><span>{{ selectedEnrollment.author }}</span></div>
                    <div class="detail-row"><span class="detail-label">责任编辑</span><span :style="{color:selectedEnrollment.editor!=='待指定'?'#303133':'#F56C6C'}">{{ selectedEnrollment.editor==='待指定'?'待指定':selectedEnrollment.editor }}</span></div>
                    <div class="detail-row"><span class="detail-label">出版时间</span><span>{{ selectedEnrollment.pubDate }}</span></div>
                    <div class="detail-row"><span class="detail-label">中图分类号</span><span>{{ selectedEnrollment.clc }}</span></div>
                    <div class="detail-row"><span class="detail-label">所属书系/专题</span><span>{{ selectedEnrollment.series||'—' }}</span></div>
                    <div class="detail-row"><span class="detail-label">文件来源</span><span>{{ selectedEnrollment.source }}</span></div>
                  </el-card>
                  <!-- 区域四+五：编目完整率明细 -->
                  <el-card shadow="never"><template #header><span class="detail-section-title"><i class="fa-solid fa-list-check" style="color:#409EFF;margin-right:4px"></i>编目完整率明细</span><span style="font-size:11px;color:#909399;margin-left:8px">已完成必填项/总必填项 × 100%</span></template>
                    <div v-for="ci in getCompletenessItems(selectedEnrollment)" :key="ci.item" class="detail-row"><span class="detail-label">{{ ci.item }}</span><span :style="{fontWeight:500,color:ci.done?'#67C23A':'#F56C6C'}">{{ ci.done?'已完成':'缺失' }}</span></div>
                  </el-card>
                </el-col>
              </el-row>
            </el-card>
          </div>

          <!-- Classification -->
          <div v-if="currentPage==='asset-standards'">
            <div class="page-title"><i class="fa-solid fa-layer-group text-primary"></i> 分级分类管理</div>
            <div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>多维多级分类定义与多层级安全定级，数据成熟度与安全分级为两套独立体系。</span></div>
            <el-row :gutter="16">
              <el-col :span="12"><el-card><template #header><span style="font-weight:600">分类体系</span></template><el-tree :data="classificationTree" :props="{label:'name',children:'children'}" default-expand-all><template #default="{node,data}"><span style="display:flex;align-items:center;gap:6px;font-size:13px"><i :class="data.icon" :style="{color:data.color||'#409EFF'}"></i>{{ data.name }}<el-tag v-if="data.count" size="small" type="info" round>{{ data.count }}</el-tag></span></template></el-tree></el-card></el-col>
              <el-col :span="12"><el-card><template #header><span style="font-weight:600">安全分级</span></template><div v-for="level in securityLevels" :key="level.name" style="display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid #f0f0f0"><div :style="{width:'40px',height:'40px',borderRadius:'10px',background:level.color,display:'flex',alignItems:'center',justifyContent:'center',color:'#fff',fontWeight:700,fontSize:'13px'}">{{ level.short }}</div><div style="flex:1"><div style="font-weight:600;font-size:14px;color:#303133">{{ level.name }}</div><div style="font-size:12px;color:#909399;margin-top:2px">{{ level.desc }}</div></div><div style="text-align:right"><div style="font-size:18px;font-weight:700;color:#303133">{{ level.count }}</div><div style="font-size:11px;color:#909399">资源数</div></div></div></el-card><el-card style="margin-top:16px"><template #header><span style="font-weight:600">数据成熟度（L0-L4）</span></template><div v-for="m in maturityLevels" :key="m.level" style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid #f5f5f5"><div :style="{width:'36px',height:'36px',borderRadius:'8px',background:m.color,display:'flex',alignItems:'center',justifyContent:'center',color:'#fff',fontWeight:700,fontSize:'13px'}">{{ m.level }}</div><div style="font-weight:500;font-size:13px;color:#303133">{{ m.name }}</div></div></el-card></el-col>
            </el-row>
          </div>

          <!-- Tags -->
          <div v-if="currentPage==='asset-tags'"><div class="page-title"><i class="fa-solid fa-tags text-primary"></i> 标签体系</div><el-card><div class="flex-between mb-16"><div style="display:flex;gap:8px"><el-button type="primary" size="small" @click="showToast('已新建标签','success')"><i class="fa-solid fa-plus"></i> 新建标签</el-button></div></div><div v-for="cat in tagCategories" :key="cat.name" style="margin-bottom:20px"><div style="font-size:14px;font-weight:600;color:#303133;margin-bottom:8px;display:flex;align-items:center;gap:6px"><i :class="cat.icon" :style="{color:cat.color}"></i> {{ cat.name }}</div><div style="display:flex;gap:6px;flex-wrap:wrap"><el-tag v-for="tag in cat.tags" :key="tag" effect="plain" round size="large" style="cursor:pointer">{{ tag }}</el-tag></div></div></el-card></div>

          <!-- Resource Upload (MOD-10) -->
          <div v-if="currentPage==='resource-upload'">
            <div class="page-title"><i class="fa-solid fa-cloud-arrow-up text-primary"></i> 资源接入</div>
            <div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>多格式资源上传、出版元数据登记、版权状态标识与接入完整性校验，确保每项资源可识别、可确权、可追溯。</span></div>
            <el-row :gutter="16">
              <el-col :span="16"><el-card class="mb-16"><template #header><span style="font-weight:600">接入流程</span></template>
                <el-steps :active="uploadStep" finish-status="success" simple style="margin-bottom:16px"><el-step title="文件上传"/><el-step title="格式校验"/><el-step title="MD5去重"/><el-step title="元数据登记"/><el-step title="版权标识"/><el-step title="原始归档"/><el-step title="结构化解析"/><el-step title="成果入库"/><el-step title="建立索引"/></el-steps>
                <div class="upload-zone" @click="startUpload"><i class="fa-solid fa-cloud-arrow-up"></i><div class="upload-text">拖拽文件到此处，或 <span class="text-primary" style="cursor:pointer">点击上传</span></div><div class="upload-hint">支持 PDF / Word / EPUB / 图片 / 音视频 / ZIP批量包，单文件最大 2GB</div></div>
                <el-alert v-if="uploadStatus" :type="uploadStatusType" :closable="false" style="margin-top:12px" :title="uploadStatus"></el-alert>
                <el-divider>最近上传（联动原始资源库与审计日志）</el-divider>
                <el-table :data="store.rawResources" stripe size="small">
                  <el-table-column prop="name" label="文件名" min-width="180"/><el-table-column prop="format" label="格式" width="60"/><el-table-column prop="size" label="大小" width="70"/>
                  <el-table-column label="校验" width="90"><template #default="{row}"><span :class="'status-tag status-'+row.checkStatus">{{ row.checkLabel }}</span></template></el-table-column>
                  <el-table-column prop="uploadedAt" label="上传时间" width="130"/>
                </el-table>
              </el-card></el-col>
              <el-col :span="8">
                <el-card class="mb-16"><template #header><span style="font-weight:600">接入完整性检查</span></template><div v-for="check in uploadChecks" :key="check.name" style="display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid #f5f5f5;font-size:12px"><i :class="check.pass?'fa-solid fa-circle-check text-success':'fa-solid fa-circle-xmark text-danger'" style="font-size:14px"></i><span style="flex:1;color:#606266">{{ check.name }}</span><el-tag size="small" :type="check.pass?'success':'danger'">{{ check.pass?'通过':'未通过' }}</el-tag></div></el-card>
                <el-card class="mb-16"><template #header><span style="font-weight:600">接入统计</span></template><div style="text-align:center"><div style="font-size:36px;font-weight:900;color:#409EFF">{{ (1247+store.rawResources.length-3).toLocaleString() }}</div><div style="font-size:13px;color:#909399;margin-top:4px">累计接入资源</div></div><el-divider/><div style="display:flex;flex-direction:column;gap:8px;font-size:13px"><div class="flex-between"><span style="color:#909399">今日新增</span><span style="font-weight:600">{{ 23+store.rawResources.length-3 }}</span></div><div class="flex-between"><span style="color:#909399">校验通过</span><span style="font-weight:600;color:#67C23A">21</span></div></div></el-card>
                <el-card><template #header><span style="font-weight:600">业务系统对接</span></template><div v-for="sys in businessSystems" :key="sys.name" style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #f5f5f5"><i :class="sys.icon" :style="{color:sys.color,fontSize:'18px'}"></i><div style="flex:1"><div style="font-size:13px;font-weight:500">{{ sys.name }}</div><div style="font-size:11px;color:#909399">{{ sys.mode }}</div></div><el-tag size="small" :type="sys.active?'success':'info'">{{ sys.active?'已连接':'待配置' }}</el-tag></div></el-card>
              </el-col>
            </el-row>
          </div>

          <!-- Original Library (MOD-11) -->
          <div v-if="currentPage==='resource-original'">
            <div class="page-title"><i class="fa-solid fa-box-archive text-primary"></i> 原始资源库</div>
            <div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>对象存储归档，确保原貌完整可追溯。可对失败/历史资源手动补发结构化解析（接入时按规则自动发起，此处为补发入口）。</span></div>
            <el-card>
              <div class="flex-between mb-16"><div style="display:flex;gap:8px;align-items:center"><el-input size="small" placeholder="搜索文件..." style="width:180px" clearable/></div><div style="display:flex;gap:8px"><el-button type="warning" size="small" @click="openParseDialog"><i class="fa-solid fa-gears"></i> 发起结构化解析</el-button><el-button type="primary" size="small" @click="startUpload"><i class="fa-solid fa-cloud-arrow-up"></i> 上传资源</el-button></div></div>
              <el-table :data="store.rawResources" stripe size="small">
                <el-table-column type="selection" width="40"/><el-table-column prop="name" label="文件名" min-width="200"/><el-table-column prop="format" label="格式" width="60"/><el-table-column prop="size" label="大小" width="70"/><el-table-column prop="md5" label="MD5指纹" width="150"/><el-table-column prop="source" label="来源" width="90"/><el-table-column prop="uploadedAt" label="归档时间" width="110"/>
                <el-table-column label="操作" width="140" fixed="right"><template #default="{row}"><el-button link type="primary" size="small" @click="onDownloadOriginalFile(row)">下载</el-button><el-button link type="primary" size="small" @click="openParseDialogFor(row)">补发解析</el-button></template></el-table-column>
              </el-table>
            </el-card>
          </div>

          <!-- Struct Results Library (MOD-05/20) -->
          <div v-if="currentPage==='resource-struct'">
            <div class="page-title"><i class="fa-solid fa-table-cells text-primary"></i> 结构化成果库</div>
            <div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>结构化结果存储，支持一键回溯原始PDF页码，每条成果附完整来源映射。</span></div>
            <div v-if="structFilterTip" class="top-tip-bar"><i class="fa-solid fa-filter"></i> {{ structFilterTip }} <el-button text size="small" @click="clearStructFilter" style="margin-left:auto">清除筛选</el-button></div>
            <el-card>
              <div class="flex-between mb-16"><div style="display:flex;gap:8px;align-items:center"><el-input v-model="structLibSearch" size="small" placeholder="搜索成果..." style="width:180px" clearable/><el-select v-model="structLibMaturity" size="small" placeholder="成熟度" clearable style="width:110px"><el-option v-for="q in maturityOptions" :key="q.val" :label="q.label" :value="q.val"/></el-select></div><span style="font-size:12px;color:#909399">共 {{ store.resultsLibraryTotal.toLocaleString() }} 条成果记录<el-tooltip content="成果=章节/段落级；总览页知识片段52,384为更细粒度chunk，口径不同"><span class="caliber-note" style="margin-left:6px"><i class="fa-solid fa-circle-info"></i>口径说明</span></el-tooltip></span></div>
              <el-table :data="filteredStructLib" stripe size="small">
                <el-table-column prop="id" label="成果编号" width="110"/><el-table-column prop="bookName" label="所属图书" min-width="140"/><el-table-column prop="chapter" label="章节路径" min-width="160"/><el-table-column prop="type" label="内容类型" width="80"/><el-table-column prop="pageRange" label="页码范围" width="80"/>
                <el-table-column label="成熟度" width="60"><template #default="{row}"><span :class="'maturity-badge maturity-'+row.maturityLevel">{{ row.maturityLevel }}</span></template></el-table-column><el-table-column prop="batch" label="批次" width="80"/>
                <el-table-column label="操作" width="120" fixed="right"><template #default="{row}"><el-button link type="primary" size="small" @click="viewStructResult(row)">查看</el-button><el-button link type="primary" size="small" @click="locateOriginalPage(row)">跳转原文</el-button></template></el-table-column>
              </el-table>
            </el-card>
          </div>

          <!-- Parse Engine (MOD-12) -->
          <div v-if="currentPage==='struct-parse'">
            <div class="page-title"><i class="fa-solid fa-gears text-primary"></i> 解析引擎</div>
            <div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>将PDF/Word/EPUB等出版内容自动拆解为章节、段落、图表、公式等结构化对象，为检索与RAG提供基础。</span></div>
            <el-row :gutter="16">
              <el-col :span="16"><el-card class="mb-16"><template #header><span style="font-weight:600">解析任务队列（联动 store.parseTasks）</span></template>
                <el-table :data="store.parseTasks" stripe size="small">
                  <el-table-column prop="bookName" label="图书名称" min-width="140"/><el-table-column prop="pages" label="页数" width="55"/><el-table-column prop="engine" label="解析引擎" width="110"/>
                  <el-table-column prop="ocrAccuracy" label="OCR准确率" width="90"><template #default="{row}"><span style="color:#67C23A">{{ row.ocrAccuracy }}</span></template></el-table-column>
                  <el-table-column prop="lowConfPages" label="低置信页" width="70"/>
                  <el-table-column label="进度" width="120"><template #default="{row}"><el-progress :percentage="row.progress" :status="row.progress===100?'success':''" :stroke-width="6"/></template></el-table-column>
                  <el-table-column label="操作" width="180" fixed="right"><template #default="{row}"><el-button link type="primary" size="small" @click="openParseReport(row)">解析报告</el-button><el-button link type="primary" size="small" @click="retryParse(row)">重新解析</el-button><el-button link type="primary" size="small" @click="currentPage='struct-calibrate'">进入校准</el-button></template></el-table-column>
                </el-table>
              </el-card></el-col>
              <el-col :span="8"><el-card class="mb-16"><template #header><span style="font-weight:600">解析能力</span></template><div v-for="engine in parseEngines" :key="engine.name" style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid #f5f5f5"><i :class="engine.icon" :style="{color:engine.color,fontSize:'20px'}"></i><div style="flex:1"><div style="font-size:13px;font-weight:500">{{ engine.name }}</div><div style="font-size:11px;color:#909399">{{ engine.desc }}</div></div><el-tag size="small" type="success">可用</el-tag></div></el-card><el-card><template #header><span style="font-weight:600">联动说明</span></template><div style="font-size:12px;color:#606266;line-height:1.8"><div><i class="fa-solid fa-circle-check text-success" style="font-size:8px;margin-right:6px"></i>发起解析→任务列表新增</div><div><i class="fa-solid fa-circle-check text-success" style="font-size:8px;margin-right:6px"></i>解析完成→成熟度提升</div><div><i class="fa-solid fa-circle-check text-success" style="font-size:8px;margin-right:6px"></i>审核通过→成果库新增版本</div></div></el-card></el-col>
            </el-row>
          </div>

          <!-- Calibration (MOD-08/13) -->
          <div v-if="currentPage==='struct-calibrate'">
            <div class="calibration-layout">
              <div class="calibration-header">
                <div style="display:flex;align-items:center;gap:12px"><i class="fa-solid fa-book-open" style="color:#409EFF;font-size:18px"></i><div><div style="font-size:14px;font-weight:600;color:#303133">大运河水利史 · 第三章 运河管理制度</div><div style="font-size:12px;color:#909399">ISBN: 978-7-5343-XXXX-X · 当前第 3/8 章</div></div></div>
                <div style="flex:1"></div><el-progress :percentage="38" :stroke-width="8" style="width:200px"/><span style="font-size:12px;color:#909399;margin-left:8px">38%</span>
                <el-button-group><el-button size="small" type="warning" @click="showToast('已暂停校准','warning')"><i class="fa-solid fa-pause"></i> 暂停</el-button><el-button size="small" type="success" @click="submitCalibration"><i class="fa-solid fa-check"></i> 提交审核</el-button></el-button-group>
                <el-button size="small" @click="calibHistoryVisible=true"><i class="fa-solid fa-clock-rotate-left"></i> 修改历史</el-button>
              </div>
              <div class="calibration-body">
                <div class="calibration-pdf"><div style="padding:8px 12px;border-bottom:1px solid #ebeef5;display:flex;align-items:center;gap:8px;font-size:12px"><span style="font-weight:600">原文预览</span><div style="flex:1"></div><span style="color:#909399">第 42 页 / 共 256 页</span></div><div class="pdf-preview"><div class="pdf-page"><div class="pdf-title">第三章 运河管理制度</div><div class="pdf-heading2">第一节 漕运管理机构的演变</div><div class="pdf-para">漕运管理制度是中国古代水利管理的重要组成部分。自隋唐大运河开通以来，历代王朝均设立了专门的漕运管理机构，以确保<span class="pdf-highlight">粮食物资的顺利运输</span>和运河水道的维护管理。</div><div class="pdf-para">隋代设立都水监，负责全国运河及水利事务的管理。唐代在都水监基础上增设水部郎中，专门掌管运河疏浚、水闸管理和漕运调度。</div><div class="pdf-heading2">第二节 明清时期的运河管理体系</div><div class="pdf-para">明清两代是中国运河管理体系最为成熟的时期。明代设总河都御史，统管南北运河事务。</div></div></div></div>
                <div class="calibration-struct"><div style="padding:8px 12px;border-bottom:1px solid #ebeef5;font-size:12px;font-weight:600">结构化结果</div><div class="struct-chapters"><div v-for="ch in calibrationChapters" :key="ch.id" class="struct-chapter-item" :class="{active:ch.active}" @click="ch.active=!ch.active;calibrationChapters.forEach(c=>{if(c.id!==ch.id)c.active=false})"><i :class="ch.active?'fa-solid fa-folder-open':'fa-solid fa-folder'" style="margin-right:6px;color:#409EFF"></i>{{ ch.name }}</div></div><div class="struct-list"><div v-for="item in structItems" :key="item.id" class="struct-item"><div class="struct-header"><el-tag :type="item.typeTag" size="small" effect="dark">{{ item.typeLabel }}</el-tag><span v-if="item.confidence<70" style="font-size:11px;color:#E6A23C"><i class="fa-solid fa-triangle-exclamation"></i> {{ item.confidence }}%</span><span v-else-if="item.confidence<90" style="font-size:11px;color:#E6A23C">{{ item.confidence }}%</span><span v-else style="font-size:11px;color:#67C23A">{{ item.confidence }}%</span><span style="margin-left:auto;font-size:11px;color:#909399">第{{ item.page }}页</span></div><div class="struct-text">{{ item.text }}</div><div class="struct-actions"><el-button link type="primary" size="small" @click="openEditParagraph(item)"><i class="fa-solid fa-pen"></i> 编辑</el-button><el-button link type="primary" size="small" @click="openSplitParagraph(item)"><i class="fa-solid fa-scissors"></i> 拆分</el-button><el-button link type="primary" size="small" @click="toggleMergeMode(item)"><i class="fa-solid fa-compress"></i> {{ mergeSelected.includes(item.id)?'取消':'合并' }}</el-button></div></div><el-button v-if="mergeSelected.length>=2" size="small" type="primary" style="width:100%;margin-top:8px" @click="doMerge"><i class="fa-solid fa-compress"></i> 合并选中的 {{ mergeSelected.length }} 段</el-button><el-button size="small" type="primary" plain style="width:100%;margin-top:8px" @click="showToast('已新增空段落','info')"><i class="fa-solid fa-plus"></i> 添加新段落</el-button></div></div>
              </div>
              <div class="calibration-footer"><div style="display:flex;align-items:center;gap:16px"><span style="font-size:12px;color:#909399">已校准: <b style="color:#67C23A">24</b> 段</span><span style="font-size:12px;color:#909399">待校准: <b style="color:#E6A23C">12</b> 段</span></div><div style="display:flex;gap:8px"><el-button size="small" @click="showToast('已切换上一章','info')"><i class="fa-solid fa-chevron-left"></i> 上一章</el-button><el-button size="small" type="success" @click="showToast('本章已标记完成','success')"><i class="fa-solid fa-check-double"></i> 标记完成</el-button><el-button size="small" @click="showToast('已切换下一章','info')">下一章 <i class="fa-solid fa-chevron-right"></i></el-button></div></div>
            </div>
          </div>

          <!-- Struct Audit (MOD-08) -->
          <div v-if="currentPage==='struct-audit'">
            <div class="page-title"><i class="fa-solid fa-clipboard-check text-primary"></i> 结构化审核</div>
            <div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>校准完成后提交至此审核队列。审核通过将生成新版本结构化成果，并同步全文索引、向量索引与来源追溯关系。</span></div>
            <el-card><template #header><div class="flex-between"><span style="font-weight:600">待审列表</span><span style="font-size:12px;color:#909399">共 {{ store.auditQueue.length }} 项待审</span></div></template>
              <div v-if="store.auditQueue.length===0" style="text-align:center;padding:40px;color:#909399"><i class="fa-solid fa-inbox" style="font-size:40px;display:block;margin-bottom:12px"></i>暂无待审项</div>
              <div v-for="item in store.auditQueue" :key="item.id" style="border:1px solid #ebeef5;border-radius:10px;padding:14px 16px;margin-bottom:10px"><div style="display:flex;align-items:center;gap:12px"><i class="fa-solid fa-book-open" style="color:#E6A23C;font-size:18px"></i><div style="flex:1"><div style="font-size:14px;font-weight:600;color:#303133">{{ item.bookName }} · {{ item.chapter }}</div><div style="font-size:12px;color:#909399;margin-top:2px">提交人：{{ item.submitter }} · 提交时间：{{ item.submitTime }} · 校准段落数：{{ item.paragraphs }}</div></div><el-button type="success" size="small" @click="approveStructAudit(item)"><i class="fa-solid fa-check"></i> 通过</el-button><el-button type="danger" size="small" @click="rejectStructAudit(item)"><i class="fa-solid fa-xmark"></i> 驳回</el-button></div></div>
            </el-card>
          </div>

          <!-- Struct Results -->
          <div v-if="currentPage==='struct-results'">
            <div class="page-title"><i class="fa-solid fa-diagram-project text-primary"></i> 结构化成果</div>
            <el-card><div class="flex-between mb-16"><el-input v-model="structResultSearch" size="small" placeholder="搜索图书..." style="width:180px" clearable/><span style="font-size:12px;color:#909399">共 {{ store.overview.structuredBooks }} 本图书已结构化</span></div>
              <el-table :data="filteredStructResults" stripe size="small">
                <el-table-column type="selection" width="40"/><el-table-column prop="bookName" label="图书名称" min-width="160"/><el-table-column prop="chapters" label="章节数" width="70"/><el-table-column prop="paragraphs" label="段落数" width="70"/><el-table-column prop="fragments" label="知识片段" width="80"/>
                <el-table-column label="成熟度" width="70"><template #default="{row}"><span :class="'maturity-badge maturity-'+row.maturityLevel">{{ row.maturityLevel }}</span></template></el-table-column><el-table-column prop="version" label="版本" width="70"/><el-table-column prop="calibrator" label="校准人" width="80"/><el-table-column prop="calibratedAt" label="校准时间" width="100"/>
                <el-table-column label="操作" width="120" fixed="right"><template #default="{row}"><el-button link type="primary" size="small" @click="currentPage='struct-calibrate'">校准</el-button><el-button link type="primary" size="small" @click="showToast('查看 '+row.bookName+' 成果详情','info')">查看</el-button></template></el-table-column>
              </el-table>
            </el-card>
          </div>

          <!-- Search (MOD-03/14/19) -->
          <div v-if="['search-fulltext','search-semantic','search-faceted','search-hybrid'].includes(currentPage)">
            <div class="search-hero"><h2>统一知识检索</h2><p style="color:#909399;font-size:14px">全文 · 语义 · 分面 · 混合 — 全方位知识发现</p></div>
            <div v-if="searchTip" class="top-tip-bar" style="max-width:900px;margin:0 auto 12px"><i class="fa-solid fa-circle-check"></i> {{ searchTip }}</div>
            <div class="search-box"><el-input v-model="searchQuery" placeholder="输入检索词或自然语言描述..." size="large" clearable @keyup.enter="doSearch"><template #prefix><i class="fa-solid fa-magnifying-glass" style="color:#909399"></i></template><template #append><el-button type="primary" @click="doSearch">检索</el-button></template></el-input></div>
            <div class="search-tabs"><div class="search-tab" :class="{active:currentPage==='search-fulltext'}" @click="currentPage='search-fulltext'">全文检索</div><div class="search-tab" :class="{active:currentPage==='search-semantic'}" @click="currentPage='search-semantic'">语义检索</div><div class="search-tab" :class="{active:currentPage==='search-faceted'}" @click="currentPage='search-faceted'">分面导航</div><div class="search-tab" :class="{active:currentPage==='search-hybrid'}" @click="currentPage='search-hybrid'">混合检索</div></div>
            <div class="search-facets" v-if="currentPage==='search-faceted'"><el-tag v-for="f in facets" :key="f" effect="plain" round style="cursor:pointer" @click="searchQuery=f;doSearch()">{{ f }}</el-tag></div>
            <div class="search-results" v-if="searchResults.length">
              <div style="font-size:13px;color:#909399;margin-bottom:12px">找到 {{ searchResults.length }} 条相关结果</div>
              <div v-for="(result,idx) in searchResults" :key="idx" class="search-result-card">
                <div class="result-source"><i class="fa-solid fa-book"></i> {{ result.book }} · {{ result.chapter }} · 第{{ result.page }}页</div>
                <div class="result-title">{{ result.title }}</div>
                <div class="result-snippet" v-html="result.snippet"></div>
                <div class="result-meta"><span><i class="fa-solid fa-tag"></i> {{ result.tags }}</span><span><i class="fa-solid fa-shield-halved"></i> {{ result.auth }}</span><span><i class="fa-solid fa-clock"></i> {{ result.year }}</span></div>
                <div class="result-actions"><el-button size="small" @click="viewOriginalPage(result)"><i class="fa-solid fa-file-pdf"></i> 查看原文</el-button><el-button size="small" @click="generateCitation(result)"><i class="fa-solid fa-quote-right"></i> 生成引用</el-button><el-button size="small" type="primary" @click="addToRagContext(result)"><i class="fa-solid fa-robot"></i> 加入问答上下文</el-button></div>
              </div>
            </div>
            <div v-else-if="searchQuery" style="text-align:center;padding:40px;color:#909399"><i class="fa-solid fa-magnifying-glass" style="font-size:48px;margin-bottom:16px;display:block"></i>输入关键词后点击检索</div>
          </div>

          <!-- RAG Chat (MOD-15) -->
          <div v-if="currentPage==='ai-rag'">
            <div class="rag-container">
              <div class="rag-sidebar"><div style="font-size:14px;font-weight:600;margin-bottom:12px;display:flex;align-items:center;gap:6px"><i class="fa-solid fa-comments text-primary"></i> 对话列表</div><el-button type="primary" size="small" style="width:100%;margin-bottom:12px" @click="newChat"><i class="fa-solid fa-plus"></i> 新建对话</el-button><div v-for="chat in ragChats" :key="chat.id" style="padding:10px;border-radius:8px;cursor:pointer;margin-bottom:4px;transition:all .2s" :style="{background:activeChat===chat.id?'#ecf5ff':'transparent'}" @click="switchChat(chat.id)"><div style="font-size:13px;font-weight:500;color:#303133">{{ chat.title }}</div><div style="font-size:11px;color:#909399;margin-top:2px">{{ chat.time }}</div></div><el-divider/><div style="font-size:13px;font-weight:600;margin-bottom:8px">引用约束模式</div><el-switch v-model="citationMode" active-text="开启" inactive-text="关闭" @change="onCitationModeChange"/><div style="font-size:11px;color:#909399;margin-top:4px;line-height:1.5">开启后，模型仅基于检索上下文作答</div><div v-if="ragContext" style="margin-top:12px;padding:8px;background:#f0f7ff;border-radius:6px;font-size:11px;color:#409EFF"><i class="fa-solid fa-link"></i> 已加入上下文：{{ ragContext.book }} 第{{ ragContext.page }}页<el-button text size="small" @click="ragContext=null" style="margin-left:4px">移除</el-button></div></div>
              <div class="rag-main"><div style="padding:12px 16px;border-bottom:1px solid #ebeef5;display:flex;align-items:center;gap:8px"><i class="fa-solid fa-robot" style="color:#409EFF"></i><span style="font-weight:600;font-size:14px">RAG 知识问答</span><el-tag v-if="citationMode" size="small" type="success" effect="dark">引用约束模式</el-tag><span style="margin-left:auto;font-size:11px;color:#909399">今日调用 {{ store.ragCallCount.toLocaleString() }} 次</span></div>
                <div class="chat-messages" ref="chatBox">
                  <div v-for="(msg,idx) in currentChatMessages" :key="idx" class="chat-msg" :class="msg.role"><div class="msg-avatar" :style="{background:msg.role==='user'?'#409EFF':'#67C23A'}"><i :class="msg.role==='user'?'fa-solid fa-user':'fa-solid fa-robot'" style="color:#fff;font-size:14px"></i></div><div class="msg-bubble"><div v-html="msg.content"></div><div v-if="msg.citations"><div v-for="(cit,ci) in msg.citations" :key="ci" class="citation-card" @click="openCitationDetail(cit)"><i class="fa-solid fa-book-open" style="margin-right:4px"></i><span style="font-weight:600">{{ cit.book }}</span> · {{ cit.chapter }} · 第{{ cit.page }}页<div style="margin-top:4px;color:#606266;font-size:11px">{{ cit.excerpt }}</div></div></div><div v-if="msg.retrievalEvidence" style="margin-top:8px"><el-button size="small" type="primary" plain @click="toggleEvidence(idx)"><i class="fa-solid fa-microscope"></i> 查看检索依据</el-button><div v-if="evidenceVisible[idx]" class="retrieval-evidence"><div class="ev-title"><i class="fa-solid fa-microscope"></i> 检索依据详情</div><div class="ev-field"><span class="ev-label">用户问题</span><span>{{ msg.retrievalEvidence.query }}</span></div><div class="ev-field"><span class="ev-label">命中片段数</span><span>{{ msg.retrievalEvidence.hitCount }}</span></div><table class="ev-table"><tr><th>序号</th><th>相似度</th><th>来源图书</th><th>页码</th><th>授权</th><th>参与</th></tr><tr v-for="(rec,ri) in msg.retrievalEvidence.top5" :key="ri"><td>{{ ri+1 }}</td><td>{{ rec.similarity }}</td><td>{{ rec.book }}</td><td>{{ rec.page }}</td><td>{{ rec.auth }}</td><td>{{ rec.used?'✓':'—' }}</td></tr></table></div></div></div></div>
                  <div v-if="ragProcessing" class="rag-process"><span class="dot"></span> {{ ragProcessText }}</div>
                </div>
                <div class="chat-input"><el-input v-model="chatInput" placeholder="输入您的问题..." @keyup.enter="sendChat" clearable/><el-button type="primary" @click="sendChat" :loading="ragProcessing"><i class="fa-solid fa-paper-plane"></i></el-button></div>
              </div>
            </div>
          </div>

          <!-- AI Models (MOD-20) -->
          <div v-if="currentPage==='ai-models'"><div class="page-title"><i class="fa-solid fa-server text-primary"></i> 模型网关</div><div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>多模型统一接入网关，屏蔽接口差异，提供统一鉴权、限流、计费与敏感信息过滤。</span></div><el-row :gutter="16"><el-col :span="16"><el-card><template #header><span style="font-weight:600">已接入模型</span></template><el-table :data="aiModels" stripe size="small"><el-table-column prop="name" label="模型名称" min-width="160"/><el-table-column prop="provider" label="供应商" width="100"/><el-table-column prop="type" label="类型" width="120"/><el-table-column label="状态" width="70"><template #default="{row}"><el-tag size="small" :type="row.active?'success':'info'">{{ row.active?'在线':'离线' }}</el-tag></template></el-table-column><el-table-column prop="latency" label="平均延迟" width="80"/><el-table-column prop="calls" label="今日调用" width="80"/><el-table-column label="操作" width="80"><template #default><el-button link type="primary" size="small" @click="showToast('已打开模型配置','info')">配置</el-button></template></el-table-column></el-table></el-card></el-col><el-col :span="8"><el-card class="mb-16"><template #header><span style="font-weight:600">调用统计</span></template><div style="text-align:center;margin-bottom:12px"><div style="font-size:28px;font-weight:900;color:#409EFF">{{ store.overview.modelGatewayCalls.toLocaleString() }}</div><div style="font-size:12px;color:#909399">今日总调用次数</div></div><div class="caliber-note" style="justify-content:center"><i class="fa-solid fa-circle-info"></i> 含摘要/改写等全量AI调用，与总览"检索RAG今日8,921"口径不同</div><div style="display:flex;flex-direction:column;gap:8px;font-size:13px;margin-top:12px"><div class="flex-between"><span style="color:#909399">Token消耗</span><span style="font-weight:600">2.4M</span></div><div class="flex-between"><span style="color:#909399">限流拦截</span><span style="font-weight:600;color:#F56C6C">23</span></div></div></el-card><el-card><template #header><span style="font-weight:600">路由策略</span></template><div style="font-size:13px;color:#606266;line-height:1.8"><div><i class="fa-solid fa-circle text-success" style="font-size:8px;margin-right:6px"></i>通用问答→通用大模型</div><div><i class="fa-solid fa-circle text-warning" style="font-size:8px;margin-right:6px"></i>敏感书稿→私有化部署</div><div><i class="fa-solid fa-circle text-primary" style="font-size:8px;margin-right:6px"></i>RAG生成→领域专用模型</div></div></el-card></el-col></el-row></div>

          <!-- Agent Workbench (MOD-19) -->
          <div v-if="currentPage==='ai-agent'"><div class="page-title"><i class="fa-solid fa-robot text-primary"></i> Agent 解决方案工作台</div><div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>基于知识中台的 Agent 解决方案编排与运行监控，支撑运营反馈中 Agent 调用数据的来源闭环。</span></div><el-row :gutter="16" class="mb-16"><el-col :span="6"><div class="stat-card" style="cursor:default"><div class="stat-icon" style="background:linear-gradient(135deg,#409EFF,#337ECC)"><i class="fa-solid fa-bolt"></i></div><div class="stat-value">{{ store.overview.agentCalls }}</div><div class="stat-label">今日 Agent 调用</div></div></el-col><el-col :span="6"><div class="stat-card" style="cursor:default"><div class="stat-icon" style="background:linear-gradient(135deg,#67C23A,#529B2E)"><i class="fa-solid fa-star"></i></div><div class="stat-value">4.2/5</div><div class="stat-label">平均用户评分</div></div></el-col><el-col :span="6"><div class="stat-card" style="cursor:default"><div class="stat-icon" style="background:linear-gradient(135deg,#E6A23C,#CF8E24)"><i class="fa-solid fa-circle-exclamation"></i></div><div class="stat-value">8.3%</div><div class="stat-label">未找到相关内容率</div></div></el-col><el-col :span="6"><div class="stat-card" style="cursor:default"><div class="stat-icon" style="background:linear-gradient(135deg,#F56C6C,#DD5A5A)"><i class="fa-solid fa-lightbulb"></i></div><div class="stat-value">12</div><div class="stat-label">高优改进建议</div></div></el-col></el-row><el-card><template #header><span style="font-weight:600">已编排 Agent</span></template><el-table :data="agentList" stripe size="small"><el-table-column prop="name" label="Agent 名称" min-width="160"/><el-table-column prop="scene" label="应用场景" width="140"/><el-table-column prop="model" label="调用模型" width="120"/><el-table-column label="状态" width="70"><template #default="{row}"><el-tag size="small" :type="row.active?'success':'info'">{{ row.active?'运行中':'已停用' }}</el-tag></template></el-table-column><el-table-column prop="calls" label="今日调用" width="80"/><el-table-column prop="satisfaction" label="评分" width="60"/><el-table-column label="操作" width="80"><template #default><el-button link type="primary" size="small" @click="showToast('已打开Agent配置','info')">配置</el-button></template></el-table-column></el-table></el-card></div>

          <!-- Prompts -->
          <div v-if="currentPage==='ai-prompts'"><div class="page-title"><i class="fa-solid fa-wand-magic-sparkles text-primary"></i> 提示词模板库</div><el-row :gutter="16"><el-col :span="8" v-for="prompt in promptTemplates" :key="prompt.id"><el-card style="margin-bottom:16px;cursor:pointer" shadow="hover" @click="showToast('已加载提示词：'+prompt.name,'info')"><div style="display:flex;align-items:center;gap:8px;margin-bottom:8px"><i :class="prompt.icon" :style="{color:prompt.color,fontSize:'18px'}"></i><span style="font-weight:600;font-size:14px">{{ prompt.name }}</span></div><div style="font-size:12px;color:#909399;line-height:1.6">{{ prompt.desc }}</div><div style="margin-top:8px;display:flex;gap:4px"><el-tag size="small" v-for="tag in prompt.tags" :key="tag">{{ tag }}</el-tag></div></el-card></el-col></el-row></div>

          <!-- Metadata -->
          <div v-if="currentPage==='gov-metadata'"><div class="page-title"><i class="fa-solid fa-database text-primary"></i> 元数据管理</div><div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>采集、管理与维护内容资源的出版元数据、结构元数据与业务元数据，支撑资产编目与血缘追溯。</span></div><el-card><div class="flex-between mb-16"><div style="display:flex;gap:8px"><el-button type="primary" size="small" @click="showToast('已创建采集任务','success')"><i class="fa-solid fa-plus"></i> 采集任务</el-button></div><el-input size="small" placeholder="搜索元数据..." style="width:200px" clearable/></div><el-table :data="metadataData" stripe size="small"><el-table-column prop="name" label="元数据名称" min-width="160"/><el-table-column prop="source" label="数据源" width="100"/><el-table-column prop="fields" label="字段数" width="60"/><el-table-column prop="records" label="记录数" width="70"/><el-table-column label="质量评分" width="110"><template #default="{row}"><el-progress :percentage="row.quality" :color="row.quality>80?'#67C23A':row.quality>60?'#E6A23C':'#F56C6C'" :stroke-width="6"/></template></el-table-column><el-table-column prop="lastSync" label="最近同步" width="120"/><el-table-column label="操作" width="120"><template #default><el-button link type="primary" size="small" @click="showToast('查看详情','info')">查看</el-button><el-button link type="primary" size="small" @click="currentPage='gov-lineage'">血统</el-button></template></el-table-column></el-table></el-card></div>

          <!-- Data Quality (MOD-17) -->
          <div v-if="currentPage==='gov-quality'"><div class="page-title"><i class="fa-solid fa-chart-column text-primary"></i> 数据质量管理</div><div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>6维度通用质量框架 + 出版业务专项规则，点击规则查看异常明细并支持一键跳转修复。</span></div><el-row :gutter="16" class="mb-16"><el-col :span="8" v-for="dim in qualityDimensions" :key="dim.name"><el-card shadow="hover"><div style="display:flex;align-items:center;gap:12px"><div :style="{width:'48px',height:'48px',borderRadius:'12px',background:dim.color,display:'flex',alignItems:'center',justifyContent:'center'}"><i :class="dim.icon" style="color:#fff;font-size:20px"></i></div><div><div style="font-size:20px;font-weight:900" :style="{color:dim.color}">{{ dim.score }}%</div><div style="font-size:13px;color:#606266;font-weight:500">{{ dim.name }}</div></div></div></el-card></el-col></el-row><el-card><template #header><span style="font-weight:600">质量检核规则（点击行查看异常明细）</span></template><el-table :data="qualityRules" stripe size="small" @row-click="openQualityExceptions"><el-table-column prop="name" label="规则名称" min-width="200"/><el-table-column prop="dimension" label="维度" width="70"/><el-table-column prop="target" label="目标实体" width="100"/><el-table-column label="通过率" width="110"><template #default="{row}"><el-progress :percentage="row.passRate" :stroke-width="6" :color="row.passRate>90?'#67C23A':row.passRate>70?'#E6A23C':'#F56C6C'"/></template></el-table-column><el-table-column prop="exceptions" label="异常数" width="70"/><el-table-column prop="lastRun" label="最近执行" width="110"/><el-table-column label="操作" width="100"><template #default="{row}"><el-button link type="primary" size="small" @click.stop="openQualityExceptions(row)">查看异常</el-button></template></el-table-column></el-table></el-card></div>

          <!-- Lineage (MOD-18) -->
          <div v-if="currentPage==='gov-lineage'"><div class="page-title"><i class="fa-solid fa-diagram-project text-primary"></i> 血缘分析 · 证据链</div><div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>追踪任一检索结果或RAG回答能否追溯到原始图书页码，形成从原始文件到API调用的完整证据链。点击节点查看详情。</span></div><el-card class="mb-16"><div style="display:flex;gap:12px;align-items:center;margin-bottom:12px"><span style="font-size:13px;font-weight:600">选择资源追溯：</span><el-select v-model="lineageResource" placeholder="选择资源" style="width:240px" @change="onLineageResourceChange"><el-option v-for="a in lineageableAssets" :key="a.id" :label="a.name" :value="a.id"/></el-select><el-button size="small" @click="ragReverseLookup"><i class="fa-solid fa-rotate-left"></i> RAG 引用反查</el-button></div><div style="text-align:center;padding:20px"><div style="display:flex;align-items:flex-start;justify-content:center;gap:6px;flex-wrap:wrap"><div v-for="(node,idx) in lineageNodes" :key="idx" style="display:flex;flex-direction:column;align-items:center;gap:4px;cursor:pointer" @click="openLineageDetail(node)"><div :style="{background:node.color,color:'#fff',padding:'8px 14px',borderRadius:'8px',fontSize:'12px',fontWeight:600,minWidth:'90px',textAlign:'center',transition:'var(--transition)'}"><i :class="node.icon" style="margin-right:4px"></i>{{ node.name }}</div><div style="font-size:10px;color:#909399;max-width:100px;text-align:center">{{ node.detail }}</div><i v-if="idx<lineageNodes.length-1" class="fa-solid fa-arrow-right" style="color:#909399;font-size:16px;margin-top:8px"></i></div></div></div></el-card></div>

          <!-- Copyright (MOD-16) -->
          <div v-if="currentPage==='gov-copyright'"><div class="page-title"><i class="fa-solid fa-copyright text-primary"></i> 版权授权台账</div><div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>控制内容资源使用范围，全流程核验。版权变更为禁用时，RAG/推送对该资源自动拦截。</span></div><el-row :gutter="12" class="mb-16"><el-col :span="6"><div class="risk-card" :class="{active:copyrightFilter==='confirmed'}" @click="setCopyrightFilter('confirmed')"><div class="rc-value text-success">{{ copyrightSummary.confirmed }}</div><div class="rc-label">已确权资源</div></div></el-col><el-col :span="6"><div class="risk-card" :class="{active:copyrightFilter==='pending'}" @click="setCopyrightFilter('pending')"><div class="rc-value text-warning">{{ copyrightSummary.pending }}</div><div class="rc-label">待确认资源</div></div></el-col><el-col :span="6"><div class="risk-card" :class="{active:copyrightFilter==='expiring'}" @click="setCopyrightFilter('expiring')"><div class="rc-value" style="color:#E6A23C">{{ copyrightSummary.expiring }}</div><div class="rc-label">30天内到期</div></div></el-col><el-col :span="6"><div class="risk-card" :class="{active:copyrightFilter==='high'}" @click="setCopyrightFilter('high')"><div class="rc-value text-danger">{{ copyrightSummary.high }}</div><div class="rc-label">高风险资源</div></div></el-col></el-row><el-card><div class="flex-between mb-16"><el-button type="primary" size="small" @click="showToast('已打开新增授权表单','info')"><i class="fa-solid fa-plus"></i> 新增授权记录</el-button><el-input size="small" placeholder="搜索..." style="width:200px" clearable v-model="copyrightSearch"/></div><el-table :data="filteredCopyrightData" stripe size="small"><el-table-column prop="resource" label="资源名称" min-width="160"/><el-table-column prop="owner" label="版权归属" width="80"/><el-table-column label="AI问答" width="70"><template #default="{row}"><el-tag size="small" :type="row.aiQA?'success':'danger'">{{ row.aiQA?'允许':'禁止' }}</el-tag></template></el-table-column><el-table-column label="模型训练" width="70"><template #default="{row}"><el-tag size="small" :type="row.training?'success':'danger'">{{ row.training?'允许':'禁止' }}</el-tag></template></el-table-column><el-table-column prop="period" label="授权期限" width="100"/><el-table-column prop="risk" label="风险" width="60"><template #default="{row}"><el-tag size="small" :type="row.risk==='低'?'success':row.risk==='中'?'warning':'danger'">{{ row.risk }}</el-tag></template></el-table-column><el-table-column label="操作" width="70"><template #default="{row}"><el-button link type="primary" size="small" @click="openEditAuthDialog(row)">编辑</el-button></template></el-table-column></el-table></el-card></div>

          <!-- Permission -->
          <div v-if="currentPage==='sec-permission'"><div class="page-title"><i class="fa-solid fa-user-shield text-primary"></i> 权限管理</div><el-row :gutter="16"><el-col :span="14"><el-card><template #header><span style="font-weight:600">角色与权限矩阵</span></template><el-table :data="permissionMatrix" stripe size="small" border><el-table-column prop="role" label="角色" width="130" fixed/><el-table-column prop="catalog" label="资产目录" width="70" align="center"><template #default="{row}"><i :class="row.catalog?'fa-solid fa-check text-success':'fa-solid fa-xmark text-danger'"></i></template></el-table-column><el-table-column prop="upload" label="资源接入" width="70" align="center"><template #default="{row}"><i :class="row.upload?'fa-solid fa-check text-success':'fa-solid fa-xmark text-danger'"></i></template></el-table-column><el-table-column prop="struct" label="结构化" width="70" align="center"><template #default="{row}"><i :class="row.struct?'fa-solid fa-check text-success':'fa-solid fa-xmark text-danger'"></i></template></el-table-column><el-table-column prop="search" label="检索" width="60" align="center"><template #default="{row}"><i :class="row.search?'fa-solid fa-check text-success':'fa-solid fa-xmark text-danger'"></i></template></el-table-column><el-table-column prop="ai" label="AI/RAG" width="70" align="center"><template #default="{row}"><i :class="row.ai?'fa-solid fa-check text-success':'fa-solid fa-xmark text-danger'"></i></template></el-table-column><el-table-column prop="admin" label="系统管理" width="70" align="center"><template #default="{row}"><i :class="row.admin?'fa-solid fa-check text-success':'fa-solid fa-xmark text-danger'"></i></template></el-table-column></el-table></el-card></el-col><el-col :span="10"><el-card><template #header><span style="font-weight:600">五层权限粒度</span></template><div v-for="layer in permissionLayers" :key="layer.name" style="display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid #f5f5f5"><div :style="{width:'36px',height:'36px',borderRadius:'8px',background:layer.color,display:'flex',alignItems:'center',justifyContent:'center',color:'#fff',fontWeight:700,fontSize:'13px'}">{{ layer.level }}</div><div><div style="font-weight:600;font-size:13px;color:#303133">{{ layer.name }}</div><div style="font-size:11px;color:#909399">{{ layer.desc }}</div></div></div></el-card></el-col></el-row></div>

          <!-- Audit (MOD-23) -->
          <div v-if="currentPage==='sec-audit'"><div class="page-title"><i class="fa-solid fa-scroll text-primary"></i> 审计日志</div><div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>Append-Only审计链路，独立审计库，保留≥3年。联动 store.auditLogs，点击行展开详情，筛选实时生效。</span></div><el-row :gutter="16"><el-col :span="16"><el-card><div class="flex-between mb-16"><div style="display:flex;gap:8px"><el-select v-model="auditFilterType" size="small" placeholder="操作类型" clearable style="width:110px"><el-option label="检索" value="检索"/><el-option label="下载" value="下载"/><el-option label="导出" value="导出"/><el-option label="管理" value="管理"/><el-option label="RAG" value="RAG"/><el-option label="API" value="API"/><el-option label="上传" value="上传"/><el-option label="结构化入库" value="结构化入库"/></el-select><el-input v-model="auditFilterUser" size="small" placeholder="操作人" clearable style="width:120px"/></div><el-button size="small" @click="showToast('审计日志已导出','success')"><i class="fa-solid fa-download"></i> 导出日志</el-button></div><el-table :data="filteredAuditLogs" stripe size="small" @row-click="toggleAuditDetail"><el-table-column type="expand"><template #default="{row}"><div style="padding:8px 16px;font-size:12px;color:#606266;background:#fafafa"><b>详情：</b>{{ row.detail }}<br><b>IP：</b>{{ row.ip }}<br><b>结果：</b><span :class="row.success?'text-success':'text-danger'">{{ row.success?'成功':'失败' }}</span></div></template></el-table-column><el-table-column prop="time" label="时间" width="140"/><el-table-column prop="user" label="操作人" width="110"/><el-table-column prop="action" label="类型" width="90"><template #default="{row}"><el-tag size="small" :type="row.actionType">{{ row.action }}</el-tag></template></el-table-column><el-table-column prop="target" label="对象" min-width="130"/><el-table-column prop="detail" label="详情" min-width="150" show-overflow-tooltip/></el-table></el-card></el-col><el-col :span="8"><el-card><template #header><span style="font-weight:600">近期审计摘要</span></template><div style="position:relative;padding-left:20px"><div style="position:absolute;left:6px;top:0;bottom:0;width:2px;background:#e8e8e8"></div><div v-for="item in auditTimeline" :key="item.time" style="position:relative;padding:10px 12px;margin-bottom:8px;background:#fff;border-radius:6px;border:1px solid #ebeef5"><div style="position:absolute;left:-18px;top:14px;width:8px;height:8px;border-radius:50%;border:2px solid #409EFF;background:#fff"></div><div style="font-size:11px;color:#909399">{{ item.time }}</div><div style="font-size:12px;color:#303133;margin-top:2px">{{ item.action }}</div></div></div></el-card></el-col></el-row></div>

          <!-- Alerts -->
          <div v-if="currentPage==='sec-alert'"><div class="page-title"><i class="fa-solid fa-triangle-exclamation text-warning"></i> 异常预警</div><el-card><el-table :data="alertData" stripe size="small"><el-table-column label="级别" width="60"><template #default="{row}"><el-tag size="small" :type="row.level==='高'?'danger':row.level==='中'?'warning':'info'">{{ row.level }}</el-tag></template></el-table-column><el-table-column prop="rule" label="触发规则" min-width="180"/><el-table-column prop="user" label="用户" width="90"/><el-table-column prop="detail" label="详情" min-width="180"/><el-table-column prop="time" label="时间" width="130"/><el-table-column label="状态" width="70"><template #default="{row}"><el-tag size="small" :type="row.handled?'success':'danger'">{{ row.handled?'已处理':'待处理' }}</el-tag></template></el-table-column><el-table-column label="操作" width="80"><template #default="{row}"><el-button link type="primary" size="small" @click="handleAlert(row)">{{ row.handled?'查看':'处理' }}</el-button></template></el-table-column></el-table></el-card></div>

          <!-- API Gateway (MOD-21) -->
          <div v-if="currentPage==='api-gateway'"><div class="page-title"><i class="fa-solid fa-plug text-primary"></i> 数据接口网关</div><div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>将中台资源、检索、权限、RAG、数据产品等能力封装为标准化接口，按业务能力分组，统一出口。</span></div><el-card class="mb-16"><div style="display:flex;gap:24px;font-size:13px"><span>今日总调用：<b style="color:#409EFF">{{ store.apiCallsTodayTotal.toLocaleString() }}</b> 次</span><span style="color:#909399">点击"测试"返回模拟响应并联动调用计数与日志</span></div></el-card><el-card><template #header><div class="flex-between"><span style="font-weight:600">接口列表（按业务能力分组）</span><el-button type="primary" size="small" @click="showToast('已打开接口注册表单','info')"><i class="fa-solid fa-plus"></i> 注册接口</el-button></div></template><div v-for="group in apiGroups" :key="group.name" class="api-group"><div class="api-group-title"><i :class="group.icon" :style="{color:group.color}"></i> {{ group.name }}</div><el-table :data="group.apis" stripe size="small" style="margin-bottom:4px"><el-table-column prop="method" label="方法" width="60"><template #default="{row}"><el-tag size="small" :type="row.method==='GET'?'success':row.method==='POST'?'primary':'warning'" effect="dark">{{ row.method }}</el-tag></template></el-table-column><el-table-column prop="path" label="路径" min-width="200"/><el-table-column prop="desc" label="描述" min-width="180"/><el-table-column prop="auth" label="鉴权" width="80"/><el-table-column prop="callsToday" label="今日调用" width="80"/><el-table-column prop="latency" label="延迟" width="70"/><el-table-column prop="status" label="状态" width="60"><template #default="{row}"><el-tag size="small" :type="row.status==='正常'?'success':'danger'">{{ row.status }}</el-tag></template></el-table-column><el-table-column label="操作" width="120"><template #default="{row}"><el-button link type="primary" size="small" @click="showApiDoc(row)">文档</el-button><el-button link type="primary" size="small" @click="testApi(row)">测试</el-button></template></el-table-column></el-table></div></el-card></div>

          <!-- Callback (MOD-22) -->
          <div v-if="currentPage==='api-callback'"><div class="page-title"><i class="fa-solid fa-rotate text-primary"></i> 成果回流</div><div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>接收加工平台回流的结构化与知识化成果，自动更新资产目录、成熟度与可用场景。点击卡片查看详情，失败项可重试。</span></div><el-card class="mb-16"><template #header><span style="font-weight:600">结构化回流</span></template><el-timeline><el-timeline-item v-for="cb in callbackStructured" :key="cb.id" :timestamp="cb.time" placement="top" :type="cb.type"><el-card shadow="hover" style="cursor:pointer" @click="openCallbackDetail(cb)"><div style="font-weight:600;font-size:14px;color:#303133">{{ cb.title }}</div><div style="font-size:12px;color:#909399;margin-top:4px">{{ cb.desc }}</div><div style="margin-top:8px;display:flex;gap:8px;align-items:center"><el-tag size="small">{{ cb.module }}</el-tag><el-tag size="small" :type="cb.status==='success'?'success':cb.status==='pending'?'warning':'danger'">{{ cb.statusLabel }}</el-tag><el-button v-if="cb.status==='failed'" link type="danger" size="small" @click.stop="retryCallback(cb)"><i class="fa-solid fa-rotate-right"></i> 重试</el-button></div></el-card></el-timeline-item></el-timeline></el-card><el-card><template #header><span style="font-weight:600">知识化回流</span></template><el-timeline><el-timeline-item v-for="cb in callbackKnowledge" :key="cb.id" :timestamp="cb.time" placement="top" :type="cb.type"><el-card shadow="hover" style="cursor:pointer" @click="openCallbackDetail(cb)"><div style="font-weight:600;font-size:14px;color:#303133">{{ cb.title }}</div><div style="font-size:12px;color:#909399;margin-top:4px">{{ cb.desc }}</div><div style="margin-top:8px;display:flex;gap:8px;align-items:center"><el-tag size="small">{{ cb.module }}</el-tag><el-tag size="small" :type="cb.status==='success'?'success':cb.status==='pending'?'warning':'danger'">{{ cb.statusLabel }}</el-tag><el-button v-if="cb.status==='failed'" link type="danger" size="small" @click.stop="retryCallback(cb)"><i class="fa-solid fa-rotate-right"></i> 重试</el-button></div></el-card></el-timeline-item></el-timeline></el-card></div>

          <!-- API Feedback (MOD-01 fix) -->
          <div v-if="currentPage==='api-feedback'"><div class="page-title"><i class="fa-solid fa-chart-line text-primary"></i> 运营反馈回流</div><div class="biz-desc-card"><i class="fa-solid fa-circle-info"></i><span>RAG问答日志、用户评价、热点问题、API调用结果与Agent使用反馈的汇总与分析。</span></div><el-card class="mb-16"><template #header><span style="font-weight:600">RAG问答日志</span></template><el-table :data="feedbackRagLogs" stripe size="small"><el-table-column prop="time" label="时间" width="130"/><el-table-column prop="query" label="用户问题" min-width="180"/><el-table-column prop="model" label="模型" width="120"/><el-table-column prop="tokens" label="Token" width="70"/><el-table-column prop="satisfaction" label="用户评分" width="80"><template #default="{row}"><el-rate v-model="row.satisfaction" disabled size="small"/></template></el-table-column></el-table></el-card><el-card class="mb-16"><template #header><span style="font-weight:600">热点问题</span></template><div v-for="(hq,i) in feedbackHotQuestions" :key="i" style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #f5f5f5;font-size:13px"><span style="color:#909399;width:24px;text-align:center">{{ i+1 }}</span><span style="flex:1;color:#303133">{{ hq.query }}</span><span style="color:#409EFF;font-weight:600">{{ hq.count }}次</span></div></el-card><el-card><template #header><div class="flex-between"><span style="font-weight:600">Agent使用反馈</span><el-button link type="primary" size="small" @click="currentPage='ai-agent'">查看 Agent 工作台 →</el-button></div></template><div style="display:flex;flex-direction:column;gap:8px;font-size:12px"><div class="flex-between"><span style="color:#909399">今日Agent调用</span><span style="font-weight:600">{{ store.overview.agentCalls }}次</span></div><div class="flex-between"><span style="color:#909399">平均用户评分</span><span style="font-weight:600;color:#67C23A">4.2/5</span></div><div class="flex-between"><span style="color:#909399">未找到相关内容率</span><span style="font-weight:600;color:#E6A23C">8.3%</span></div><div class="flex-between"><span style="color:#909399">高优改进建议</span><span style="font-weight:600;color:#409EFF">12条</span></div></div></el-card></div>

          <!-- Settings (MOD-07) -->
          <div v-if="currentPage==='settings'"><div class="page-title"><i class="fa-solid fa-gear text-primary"></i> 系统设置</div><el-row :gutter="16"><el-col :span="12"><el-card class="mb-16"><template #header><span style="font-weight:600">基础配置</span></template><el-form label-width="100px" size="small"><el-form-item label="平台名称"><el-input value="知识数据中台"/></el-form-item><el-form-item label="当前版本"><el-input value="v1.0.0" disabled/></el-form-item><el-form-item label="组织模式"><el-radio-group v-model="orgMode"><el-radio-button label="single">单组织模式</el-radio-button><el-radio-button label="group">集团组织模式</el-radio-button><el-radio-button label="multi">多机构协同模式</el-radio-button></el-radio-group></el-form-item><el-form-item label="对象存储"><el-input value="凤凰云 OSS"/></el-form-item><el-form-item><el-button type="primary" @click="showToast('配置已保存','success')">保存配置</el-button></el-form-item></el-form></el-card></el-col><el-col :span="12"><el-card class="mb-16" v-if="orgMode!=='single'"><template #header><span style="font-weight:600">{{ orgMode==='group'?'集团/多机构概况':'多机构协同概况' }}（只读）</span></template><el-row :gutter="12"><el-col :span="8" v-for="org in orgOverview" :key="org.name"><div class="org-card"><div class="oc-name">{{ org.name }}</div><div class="oc-stat"><div><div class="oc-num">{{ org.resources }}</div><div class="oc-lbl">资源量</div></div><div><div class="oc-num">{{ org.calls }}</div><div class="oc-lbl">今日调用</div></div></div></div></el-col></el-row></el-card><el-card class="mb-16"><template #header><span style="font-weight:600">存储引擎状态</span></template><div v-for="engine in storageEngines" :key="engine.name" style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid #f5f5f5"><div :style="{width:'36px',height:'36px',borderRadius:'8px',background:engine.color,display:'flex',alignItems:'center',justifyContent:'center'}"><i :class="engine.icon" style="color:#fff;font-size:14px"></i></div><div style="flex:1"><div style="font-size:13px;font-weight:500">{{ engine.name }}</div><div style="font-size:11px;color:#909399">{{ engine.version }}</div></div><el-tag size="small" :type="engine.active?'success':'danger'">{{ engine.active?'正常':'异常' }}</el-tag></div></el-card><el-card><template #header><span style="font-weight:600">组织与用户</span></template><div style="display:flex;gap:16px;text-align:center"><div style="flex:1;padding:16px;background:#f0f7ff;border-radius:8px"><div style="font-size:24px;font-weight:900;color:#409EFF">5</div><div style="font-size:12px;color:#909399">部门</div></div><div style="flex:1;padding:16px;background:#f0f9eb;border-radius:8px"><div style="font-size:24px;font-weight:900;color:#67C23A">28</div><div style="font-size:12px;color:#909399">用户</div></div><div style="flex:1;padding:16px;background:#fdf6ec;border-radius:8px"><div style="font-size:24px;font-weight:900;color:#E6A23C">8</div><div style="font-size:12px;color:#909399">角色</div></div></div></el-card></el-col></el-row></div>

        </main>
      </div>
    </div>

    <!-- Dialogs: Push (MOD-02) -->
    <el-dialog v-model="pushDialogVisible" title="推送至加工平台" width="520px"><div style="font-size:13px;line-height:1.8;color:#606266">当前资源将以标准化资产形式推送至高质量数据集加工平台。<br><br><b>知识数据中台</b>负责资源登记、版权状态、结构化成果、来源追溯和能力输出；<br><b>加工平台</b>负责深度标注、审核、质检和数据产品封装。<br><br>加工完成后成果将回流中台，并写入审计日志。</div><template #footer><el-button @click="pushDialogVisible=false">取消</el-button><el-button type="primary" @click="confirmPush">确认推送</el-button></template></el-dialog>
    <!-- Edit metadata (MOD-05) -->
    <el-dialog v-model="editMetaDialogVisible" title="编辑元数据" width="560px"><el-form :model="editMetaForm" label-width="100px" size="small"><el-form-item label="ISBN"><el-input v-model="editMetaForm.isbn"/></el-form-item><el-form-item label="CIP"><el-input v-model="editMetaForm.cip"/></el-form-item><el-form-item label="作者/主编"><el-input v-model="editMetaForm.author"/></el-form-item><el-form-item label="责任编辑"><el-input v-model="editMetaForm.editor"/></el-form-item><el-form-item label="出版时间"><el-input v-model="editMetaForm.pubDate"/></el-form-item><el-form-item label="中图分类号"><el-input v-model="editMetaForm.clc"/></el-form-item><el-form-item label="所属专题"><el-input v-model="editMetaForm.topic"/></el-form-item><el-form-item label="关键词"><el-input v-model="editMetaForm.tagsStr" placeholder="多个关键词用、分隔"/></el-form-item><el-form-item label="摘要"><el-input v-model="editMetaForm.abstract_" type="textarea" :rows="3"/></el-form-item></el-form><template #footer><el-button @click="editMetaDialogVisible=false">取消</el-button><el-button type="primary" @click="saveEditMeta">保存</el-button></template></el-dialog>
    <!-- Edit auth (MOD-05/16) -->
    <el-dialog v-model="editAuthDialogVisible" title="管理授权" width="600px"><div v-if="editAuthForm.resource" style="margin-bottom:12px;font-size:13px"><b>资源：</b>{{ editAuthForm.resource }}</div><el-form :model="editAuthForm" label-width="120px" size="small"><el-form-item label="合同编号"><el-input v-model="editAuthForm.contractNo"/></el-form-item><el-form-item label="授权文件"><el-input v-model="editAuthForm.authFile" placeholder="授权文件名/链接"/></el-form-item><el-form-item label="授权期限"><el-input v-model="editAuthForm.authPeriod"/></el-form-item><el-form-item label="数据库展示"><el-switch v-model="editAuthForm.dbDisplay"/></el-form-item><el-form-item label="AI问答"><el-switch v-model="editAuthForm.aiQA"/></el-form-item><el-form-item label="模型训练"><el-switch v-model="editAuthForm.training"/></el-form-item><el-form-item label="对外交付"><el-switch v-model="editAuthForm.delivery"/></el-form-item><el-form-item label="第三方素材"><el-select v-model="editAuthForm.thirdPartyStatus" style="width:100%"><el-option label="无第三方素材" value="无"/><el-option label="含第三方·已授权" value="已授权"/><el-option label="含第三方·待授权" value="待授权"/></el-select></el-form-item><el-form-item label="风险等级"><el-select v-model="editAuthForm.risk" style="width:100%"><el-option label="低" value="低"/><el-option label="中" value="中"/><el-option label="高" value="高"/></el-select></el-form-item></el-form><template #footer><el-button @click="editAuthDialogVisible=false">取消</el-button><el-button type="primary" @click="saveEditAuth">保存</el-button></template></el-dialog>
    <!-- Submit audit (MOD-08) -->
    <el-dialog v-model="submitAuditDialogVisible" title="提交审核" width="520px"><div style="font-size:13px;line-height:1.8;color:#606266"><el-alert type="info" :closable="false" style="margin-bottom:12px">校准完成后将提交至结构化审核队列；审核通过后系统生成新的结构化成果版本，并同步更新全文索引、向量索引与来源追溯关系。</el-alert>确认提交《大运河水利史 · 第三章》的校准结果至审核队列？</div><template #footer><el-button @click="submitAuditDialogVisible=false">取消</el-button><el-button type="primary" @click="confirmSubmitAudit">确认提交</el-button></template></el-dialog>
    <!-- Upload sim (MOD-10) -->
    <el-dialog v-model="uploadDialogVisible" title="模拟文件上传" width="480px"><div style="font-size:13px;color:#606266;line-height:1.8"><p>演示模拟上传流程（联动原始资源库与审计日志）：</p><ol style="padding-left:20px;margin:8px 0"><li>新增上传文件记录</li><li>格式校验中…</li><li>2 秒后校验通过</li><li>元数据缺失则提示补全 ISBN/CIP</li><li>确认版权状态</li><li>确认入库→原始资源库新增记录</li><li>审计日志新增上传记录</li></ol><p style="color:#909399">点击"开始模拟"将自动走完流程。</p></div><template #footer><el-button @click="uploadDialogVisible=false">取消</el-button><el-button type="primary" @click="runUploadSimulation" :loading="uploadSimulating">{{ uploadSimulating?'模拟中…':'开始模拟' }}</el-button></template></el-dialog>
    <!-- Parse dialog (MOD-11) -->
    <el-dialog v-model="parseDialogVisible" title="发起结构化解析（手动补发）" width="520px"><div style="font-size:12px;color:#909399;margin-bottom:12px"><i class="fa-solid fa-circle-info"></i> 接入流程中已按规则自动发起解析；此处为对失败/历史资源的手动补发入口。</div><el-form :model="parseForm" label-width="110px" size="small"><el-form-item label="目标文件"><el-input v-model="parseForm.fileName" disabled/></el-form-item><el-form-item label="解析引擎"><el-select v-model="parseForm.engine" style="width:100%"><el-option v-for="e in parseEngines" :key="e.name" :label="e.name" :value="e.name"/></el-select></el-form-item><el-form-item label="OCR识别"><el-switch v-model="parseForm.ocr"/></el-form-item><el-form-item label="表格识别"><el-switch v-model="parseForm.table"/></el-form-item><el-form-item label="公式识别"><el-switch v-model="parseForm.formula"/></el-form-item><el-form-item label="页码映射"><el-switch v-model="parseForm.pageMap"/></el-form-item><el-form-item label="生成报告"><el-switch v-model="parseForm.report"/></el-form-item></el-form><template #footer><el-button @click="parseDialogVisible=false">取消</el-button><el-button type="primary" @click="confirmParse">确认发起</el-button></template></el-dialog>
    <!-- Parse report drawer (MOD-12) -->
    <el-drawer v-model="parseReportVisible" title="解析报告详情" size="480px" direction="rtl"><div v-if="parseReportData" style="font-size:13px;line-height:1.8"><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">任务编号</span><span style="font-weight:600">{{ parseReportData.taskId }}</span></div><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">文件名</span><span style="font-weight:600">{{ parseReportData.bookName }}</span></div><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">总页数</span><span style="font-weight:600">{{ parseReportData.pages }}</span></div><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">成功页</span><span style="font-weight:600;color:#67C23A">{{ parseReportData.successPages }}</span></div><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">异常页</span><span style="font-weight:600;color:#F56C6C">{{ parseReportData.failedPages }}</span></div><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">章节/段落/图表/公式</span><span style="font-weight:600">{{ parseReportData.chapters }}/{{ parseReportData.paragraphs }}/{{ parseReportData.figures }}/{{ parseReportData.formulas }}</span></div><div style="margin-top:12px;font-weight:600;color:#303133">低置信内容列表：</div><div style="background:#fdf6ec;border:1px solid #faecd8;border-radius:6px;padding:8px 12px;margin-top:6px;font-size:12px;color:#E6A23C">第 {{ parseReportData.lowConfPages }} 页 — 内容模糊/排版异常，建议人工复核</div><div style="margin-top:12px;font-weight:600;color:#303133">失败页列表：</div><div style="background:#fef0f0;border:1px solid #fde2e2;border-radius:6px;padding:8px 12px;margin-top:6px;font-size:12px;color:#F56C6C">第 {{ parseReportData.failedPages }} 页 — 解析失败，可重新解析</div><div style="margin-top:16px;display:flex;gap:8px"><el-button size="small" @click="retryParse(parseReportData);parseReportVisible=false"><i class="fa-solid fa-rotate-right"></i> 重新解析</el-button><el-button size="small" type="primary" @click="parseReportVisible=false;currentPage='struct-calibrate'"><i class="fa-solid fa-pen"></i> 进入校准</el-button></div></div></el-drawer>
    <!-- Edit paragraph (MOD-13) -->
    <el-dialog v-model="editParaDialogVisible" title="编辑段落" width="520px"><el-form :model="editParaForm" label-width="90px" size="small"><el-form-item label="段落类型"><el-select v-model="editParaForm.typeLabel" style="width:100%"><el-option label="一级标题" value="一级标题"/><el-option label="二级标题" value="二级标题"/><el-option label="正文" value="正文"/><el-option label="表格" value="表格"/><el-option label="图注" value="图注"/></el-select></el-form-item><el-form-item label="正文"><el-input v-model="editParaForm.text" type="textarea" :rows="4"/></el-form-item><el-form-item label="页码"><el-input v-model="editParaForm.page"/></el-form-item><el-form-item label="置信度"><el-input v-model="editParaForm.confidence"/></el-form-item><el-form-item label="修改原因"><el-input v-model="editParaForm.reason" placeholder="必填，将记入修改历史"/></el-form-item></el-form><template #footer><el-button @click="editParaDialogVisible=false">取消</el-button><el-button type="primary" @click="saveEditPara">保存</el-button></template></el-dialog>
    <!-- Split paragraph (MOD-13) -->
    <el-dialog v-model="splitParaDialogVisible" title="拆分段落" width="520px"><div style="font-size:12px;color:#909399;margin-bottom:8px">原段落：</div><div style="background:#f4f6f8;border-radius:6px;padding:10px;font-size:13px;color:#606266;margin-bottom:12px">{{ splitParaForm.originalText }}</div><el-form label-width="90px" size="small"><el-form-item label="拆分位置"><el-input-number v-model="splitParaForm.position" :min="1" :max="splitParaForm.originalText.length" style="width:100%"/></el-form-item></el-form><div style="font-size:12px;color:#909399;margin-top:8px">将拆为两段：第1段截取到第 {{ splitParaForm.position }} 字，第2段为剩余内容。</div><template #footer><el-button @click="splitParaDialogVisible=false">取消</el-button><el-button type="primary" @click="confirmSplit">确认拆分</el-button></template></el-dialog>
    <!-- Calib history (MOD-13) -->
    <el-dialog v-model="calibHistoryVisible" title="修改历史" width="560px"><el-timeline><el-timeline-item v-for="(h,i) in calibHistory" :key="i" :timestamp="h.time" placement="top"><div style="font-size:13px;color:#303133">{{ h.action }}</div><div style="font-size:12px;color:#909399;margin-top:2px">原因：{{ h.reason }}</div></el-timeline-item></el-timeline></el-dialog>
    <!-- View original (MOD-14) -->
    <el-dialog v-model="pdfPreviewVisible" :title="'原文预览 · 第'+(pdfPreviewPage||1)+'页'" width="600px"><div class="pdf-preview" style="max-height:60vh;border-radius:8px"><div class="pdf-page"><div class="pdf-title">{{ pdfPreviewTitle }}</div><div class="pdf-para" style="color:#333">已定位到第 {{ pdfPreviewPage }} 页，对应片段高亮显示。原文内容预览（演示）。</div></div></div></el-dialog>
    <!-- Citation (MOD-14) -->
    <el-dialog v-model="citationDialogVisible" title="生成引用" width="480px"><div style="background:#f4f6f8;border-radius:8px;padding:14px;font-size:13px;color:#303133;line-height:1.8;font-family:monospace">{{ citationText }}</div><template #footer><el-button @click="citationDialogVisible=false">关闭</el-button><el-button type="primary" @click="copyCitation">复制引用</el-button></template></el-dialog>
    <!-- Source detail (MOD-15) -->
    <el-dialog v-model="sourceDetailVisible" title="来源片段详情" width="480px"><div v-if="sourceDetail" style="font-size:13px;line-height:1.8"><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">书名</span><span style="font-weight:600">{{ sourceDetail.book }}</span></div><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">章节</span><span style="font-weight:600">{{ sourceDetail.chapter }}</span></div><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">页码</span><span style="font-weight:600">第 {{ sourceDetail.page }} 页</span></div><div style="margin-top:8px;color:#606266">{{ sourceDetail.excerpt }}</div></div></el-dialog>
    <!-- Citation warn (MOD-15) -->
    <el-dialog v-model="citationWarnVisible" title="引用约束已关闭" width="440px"><el-alert type="warning" :closable="false">引用约束模式已关闭。此时模型回答可能包含无来源陈述，无法保证可追溯性。建议在正式演示与生产环境中保持开启。</el-alert><template #footer><el-button type="primary" @click="citationWarnVisible=false">我知道了</el-button></template></el-dialog>
    <!-- Download (MOD-16) -->
    <el-dialog v-model="downloadDialogVisible" :title="downloadTitle" width="440px"><div style="font-size:13px;color:#606266;line-height:1.8">{{ downloadMsg }}</div><template #footer><el-button v-if="downloadAllowed" type="primary" @click="confirmDownload">确认下载</el-button><el-button @click="downloadDialogVisible=false">关闭</el-button></template></el-dialog>
    <!-- Quality exception (MOD-17) -->
    <el-dialog v-model="qualityExcVisible" :title="'异常明细 · '+ (qualityExcRule||'')" width="720px"><el-table :data="qualityExceptions" stripe size="small" max-height="400"><el-table-column prop="resource" label="异常资源" min-width="140"/><el-table-column prop="field" label="问题字段" width="100"/><el-table-column prop="current" label="当前值" width="100"/><el-table-column prop="desc" label="问题说明" min-width="140"/><el-table-column prop="suggestion" label="修复建议" min-width="120"/><el-table-column prop="owner" label="责任人" width="80"/><el-table-column label="操作" width="90" fixed="right"><template #default="{row}"><el-button link type="primary" size="small" @click="jumpToFix(row)">跳转编辑</el-button></template></el-table-column></el-table></el-dialog>
    <!-- Lineage detail (MOD-18) -->
    <el-dialog v-model="lineageDetailVisible" :title="'血缘节点详情 · '+ (lineageDetailNode?.name||'')" width="520px"><div v-if="lineageDetailNode" style="font-size:13px;line-height:1.8"><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">节点</span><span style="font-weight:600">{{ lineageDetailNode.name }}</span></div><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">说明</span><span>{{ lineageDetailNode.detail }}</span></div><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">任务编号</span><span>{{ lineageDetailNode.taskId||'B20260610' }}</span></div><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">处理批次</span><span>{{ lineageDetailNode.batch||'B20260610' }}</span></div><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">原文页码</span><span>{{ lineageDetailNode.page||'42-43' }}</span></div><div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap"><el-button size="small" @click="currentPage='struct-parse';lineageDetailVisible=false">查看处理批次</el-button><el-button size="small" @click="viewOriginalPage({book:lineageResourceName,chapter:'第三章',page:42,title:lineageResourceName});lineageDetailVisible=false">查看原文页码</el-button><el-button size="small" @click="currentPage='sec-audit';lineageDetailVisible=false">查看审计记录</el-button></div></div></el-dialog>
    <!-- API test (MOD-21) -->
    <el-dialog v-model="apiTestVisible" :title="'接口测试 · '+ (apiTestApi?.path||'')" width="640px"><div style="font-size:12px;color:#909399;margin-bottom:8px">请求方法：{{ apiTestApi?.method }} · 已联动调用计数 +1 并写入审计日志</div><div style="background:#1e1e1e;color:#0f0;border-radius:6px;padding:12px;font-size:12px;font-family:monospace;max-height:320px;overflow:auto;white-space:pre-wrap">{{ apiTestResponse }}</div><template #footer><el-button @click="apiTestVisible=false">关闭</el-button></template></el-dialog>
    <!-- Callback detail (MOD-22) -->
    <el-dialog v-model="callbackDetailVisible" title="回流详情" width="520px"><div v-if="callbackDetail" style="font-size:13px;line-height:1.8"><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">标题</span><span style="font-weight:600">{{ callbackDetail.title }}</span></div><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">模块</span><span>{{ callbackDetail.module }}</span></div><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">时间</span><span>{{ callbackDetail.time }}</span></div><div class="flex-between" style="padding:6px 0;border-bottom:1px solid #f5f5f5"><span style="color:#909399">状态</span><span><el-tag size="small" :type="callbackDetail.status==='success'?'success':callbackDetail.status==='pending'?'warning':'danger'">{{ callbackDetail.statusLabel }}</el-tag></span></div><div style="margin-top:8px;color:#606266">{{ callbackDetail.desc }}</div><div v-if="callbackDetail.status==='failed'" style="margin-top:12px"><el-button type="danger" size="small" @click="retryCallback(callbackDetail);callbackDetailVisible=false"><i class="fa-solid fa-rotate-right"></i> 重试回流</el-button></div></div></el-dialog>
  </div>

  <script src="https://unpkg.com/vue@3.4.27/dist/vue.global.prod.js"></script>
