        if(sr){sr.version='v'+(parseFloat(sr.version.slice(1))+0.1).toFixed(1);sr.maturityLevel='L3';sr.calibratedAt=new Date().toISOString().slice(0,10)}
        addAuditLog({action:'结构化入库',actionType:'success',target:item.bookName+'·'+item.chapter,detail:'审核通过，生成新版本，同步全文索引+向量索引+来源追溯'});
        pushNotif(`《${item.bookName}》结构化审核通过，成果库已更新`,'fa-solid fa-check','#67C23A','struct-results');
        showToast('审核通过，成果库已更新版本','success');
      };
      const rejectStructAudit=(item)=>{
        const idx=store.auditQueue.indexOf(item);
        if(idx>=0)store.auditQueue.splice(idx,1);
        addAuditLog({action:'结构化入库',actionType:'danger',target:item.bookName+'·'+item.chapter,detail:'审核驳回，退回校准',success:false});
        showToast('已驳回，退回校准工作台','warning');
      };

      // ===== MOD-05/20 结构化成果库 =====
      const structLibSearch=ref('');const structLibMaturity=ref('');const structFilterTip=ref('');
      const structLibData=ref([]);
      (function initStructLib(){
        const books=store.structuredResults;
        const types=['正文','标题','图注','表格'];
        books.forEach(b=>{
          for(let i=0;i<8;i++){
            structLibData.value.push({id:'SR-'+b.id+'-'+String(i+1).padStart(3,'0'),bookName:b.bookName,chapter:'第'+['一','二','三','四','五'][i%5]+'章 · '+(i%2?'上':'下')+'篇',type:types[i%4],pageRange:(i*5+20)+'-'+(i*5+24),maturityLevel:b.maturityLevel,batch:'B20260610'});
          }
        });
      })();
      const filteredStructLib=computed(()=>{
        return structLibData.value.filter(r=>{
          if(structLibSearch.value&&!r.bookName.includes(structLibSearch.value)&&!r.chapter.includes(structLibSearch.value))return false;
          if(structLibMaturity.value&&r.maturityLevel!==structLibMaturity.value)return false;
          return true;
        });
      });
      const clearStructFilter=()=>{structLibSearch.value='';structFilterTip.value=''};
      const viewStructResult=(row)=>{pdfPreviewTitle.value=row.bookName;pdfPreviewPage.value=parseInt(row.pageRange);pdfPreviewVisible.value=true};
      const locateOriginalPage=(row)=>{viewOriginalPage({book:row.bookName,chapter:row.chapter,page:parseInt(row.pageRange),title:row.bookName})};

      // 结构化成果页
      const structResultSearch=ref('');
      const filteredStructResults=computed(()=>{
        if(!structResultSearch.value)return store.structuredResults;
        return store.structuredResults.filter(r=>r.bookName.includes(structResultSearch.value));
      });

      // ===== MOD-03/14/19 检索 =====
      const searchQuery=ref('');const searchResults=ref(store.searchResults?[...store.searchResults]:[]);const searchTip=ref('');
      const facets=ref(['漕运管理','运河疏浚','明清水利','水闸制度','都水监','总河都御史']);
      const mockSearchPool=[
        {book:'大运河水利史',chapter:'第三章 运河管理制度',page:42,title:'漕运管理机构的演变',snippet:'漕运管理制度是中国古代水利管理的重要组成部分。自隋唐大运河开通以来，历代王朝均设立了专门的漕运管理机构，以确保<span class="pdf-highlight">粮食物资的顺利运输</span>和运河水道的维护管理。',tags:'历史·运河',auth:'已授权',year:'2023'},
        {book:'大运河水利史',chapter:'第三章 运河管理制度',page:43,title:'明清运河管理体系',snippet:'明清两代是中国运河管理体系最为成熟的时期。明代设<span class="pdf-highlight">总河都御史</span>，统管南北运河事务，下设管河郎中、管河主事等职位。',tags:'历史·明清',auth:'已授权',year:'2023'},
        {book:'明代建筑图谱',chapter:'第五章 官式建筑',page:88,title:'运河沿线建筑规制',snippet:'运河沿线城市建筑受漕运经济影响，形成独特的商业建筑风格与码头仓储规制。',tags:'建筑·明代',auth:'已授权',year:'2021'},
        {book:'江苏非遗图录',chapter:'第二章 运河民俗',page:56,title:'运河船工号子',snippet:'运河船工号子是漕运文化的重要非物质文化遗产，反映了古代水上运输劳动场景。',tags:'非遗·民俗',auth:'已授权',year:'2024'}
      ];
      const doSearch=()=>{
        if(!searchQuery.value.trim()){showToast('请输入检索词','info');return}
        searchTip.value='';
        const isSemantic=['search-semantic','search-hybrid'].includes(currentPage.value);
        const results=mockSearchPool.filter(r=>r.title.includes(searchQuery.value)||r.snippet.includes(searchQuery.value)||(isSemantic&&r.book.includes(searchQuery.value)));
        // 语义检索放宽匹配
        searchResults.value=results.length?results:(isSemantic?mockSearchPool.slice(0,2):[]);
        addAuditLog({action:'检索',actionType:'primary',target:searchQuery.value,detail:currentPage.value+'，命中'+searchResults.value.length+'条'});
        if(isSemantic)searchTip.value='语义检索已启用向量召回，结果按相似度排序';
        else searchTip.value='全文检索完成，结果按相关度排序';
      };
      // 原文预览
      const pdfPreviewVisible=ref(false);const pdfPreviewPage=ref(1);const pdfPreviewTitle=ref('');
      const viewOriginalPage=(r)=>{
        pdfPreviewTitle.value=r.title||r.book;pdfPreviewPage.value=r.page||1;pdfPreviewVisible.value=true;
      };
      // 生成引用
      const citationDialogVisible=ref(false);const citationText=ref('');
      const generateCitation=(r)=>{
        citationText.value=`${r.book}. ${r.chapter}[M]. 第${r.page}页. ${r.year}年.`;
        citationDialogVisible.value=true;
      };
      const copyCitation=()=>{
        navigator.clipboard&&navigator.clipboard.writeText(citationText.value);
        showToast('引用已复制到剪贴板','success');
      };
      // 加入RAG上下文
      const ragContext=ref(null);
      const addToRagContext=(r)=>{
        ragContext.value={book:r.book,page:r.page,chapter:r.chapter};
        showToast('已加入RAG问答上下文，可在RAG页引用','success');
      };

      // ===== MOD-15 RAG（绑定 store.ragChats）=====
      const ragChats=computed(()=>store.ragChats.map(c=>({id:c.id,title:c.title,time:c.createdAt})));
      const activeChat=ref(1);
      const chats=reactive({
        1:[{role:'assistant',content:'您好，我是知识中台RAG助手，可基于已结构化的出版资源回答问题。请问您想了解什么？'}],
        2:[{role:'assistant',content:'您好，请输入您的问题。'}]
      });
      const currentChatMessages=computed(()=>chats[activeChat.value]||[]);
      const chatInput=ref('');const ragProcessing=ref(false);const ragProcessText=ref('');const evidenceVisible=reactive({});
      const citationMode=ref(true);
      const citationWarnVisible=ref(false);
      const sourceDetailVisible=ref(false);const sourceDetail=ref(null);

      const newChat=()=>{
        const id=Math.max(...ragChats.value.map(c=>c.id))+1;
        ragChats.value.unshift({id,title:'新对话',time:new Date().toLocaleTimeString('zh-CN',{hour:'2-digit',minute:'2-digit'})});
        chats[id]=[{role:'assistant',content:'新对话已创建，请输入您的问题。'}];
        activeChat.value=id;
      };
      const switchChat=(id)=>{activeChat.value=id};
      const onCitationModeChange=(val)=>{
        if(!val)citationWarnVisible.value=true;
        addAuditLog({action:'RAG',target:'引用约束模式',detail:val?'开启':'关闭'});
      };
      const sendChat=()=>{
        const q=chatInput.value.trim();if(!q||ragProcessing.value)return;
        chats[activeChat.value].push({role:'user',content:q});
        chatInput.value='';
        ragProcessing.value=true;
        const steps=['正在检索知识库…','向量召回中…','重排序Top5片段…','版权校验中…','生成回答…'];
        let si=0;
        const stepTimer=setInterval(()=>{
          if(si>=steps.length){
            clearInterval(stepTimer);
            // 版权拦截检查
            const blockedBooks=store.copyrightLedger.filter(c=>!c.aiQA).map(c=>c.resource);
            let answer='';
            let citations=[];
            let retrievalEvidence=null;
            if(q.includes('运河')||q.includes('漕运')){
              answer='根据《大运河水利史》记载，明清两代是中国运河管理体系最为成熟的时期。明代设<b>总河都御史</b>，统管南北运河事务，下设管河郎中、管河主事等职位，形成了从中央到地方的垂直管理体系。';
              citations=[
                {book:'大运河水利史',chapter:'第三章 运河管理制度',page:42,excerpt:'漕运管理制度是中国古代水利管理的重要组成部分…'},
                {book:'大运河水利史',chapter:'第三章 运河管理制度',page:43,excerpt:'明代设总河都御史，统管南北运河事务…'}
              ];
              retrievalEvidence={query:q,hitCount:5,top5:[
                {similarity:'0.92',book:'大运河水利史',page:42,auth:'已授权',used:true},
                {similarity:'0.88',book:'大运河水利史',page:43,auth:'已授权',used:true},
                {similarity:'0.85',book:'明代建筑图谱',page:88,auth:'已授权',used:false},
                {similarity:'0.79',book:'江苏非遗图录',page:56,auth:'已授权',used:false},
                {similarity:'0.72',book:'中医药图鉴·上册',page:120,auth:'禁止',used:false}
              ]};
            }else if(q.includes('版权')&&blockedBooks.length){
              answer=`检测到以下资源版权禁止AI问答：${blockedBooks.join('、')}。已自动从检索结果中过滤。`;
            }else{
              answer='已基于知识库检索相关内容。根据已结构化资源，该问题的相关内容可在《大运河水利史》等文献中找到参考。如需更详细解答，请尝试更具体的提问。';
              citations=[{book:'大运河水利史',chapter:'第三章',page:42,excerpt:'相关内容片段…'}];
            }
            chats[activeChat.value].push({role:'assistant',content:answer,citations:citationMode.value?citations:[],retrievalEvidence:retrievalEvidence});
            ragProcessing.value=false;
            store.ragCallCount++;
            addAuditLog({action:'RAG',actionType:'info',target:'RAG问答',detail:'问题：'+q+'，引用约束='+(citationMode.value?'开':'关')});
            nextTick(()=>{const box=document.querySelector('.chat-messages');if(box)box.scrollTop=box.scrollHeight});
          }else{
            ragProcessText.value=steps[si];si++;
          }
        },600);
      };
      const openCitationDetail=(cit)=>{
        sourceDetail.value=cit;sourceDetailVisible.value=true;
      };
      const toggleEvidence=(idx)=>{evidenceVisible[idx]=!evidenceVisible[idx]};

      // ===== AI 模型 / Agent / 提示词 =====
      const aiModels=ref([
        {name:'GPT-4',provider:'OpenAI',type:'对话生成',active:true,latency:'1.2s',calls:3284},
        {name:'Claude-3',provider:'Anthropic',type:'对话生成',active:true,latency:'0.9s',calls:2156},
        {name:'BGE-M3',provider:'智源',type:'向量编码',active:true,latency:'0.3s',calls:8420},
        {name:'bge-reranker',provider:'智源',type:'重排序',active:true,latency:'0.2s',calls:8420},
        {name:'Qwen-VL',provider:'阿里',type:'图文识别',active:false,latency:'1.5s',calls:0}
      ]);
      const agentList=ref([
        {name:'文献检索Agent',scene:'学术研究',model:'GPT-4',active:true,calls:128,satisfaction:4.5},
        {name:'知识问答Agent',scene:'读者服务',model:'Claude-3',active:true,calls:89,satisfaction:4.3},
        {name:'内容审核Agent',scene:'质量管理',model:'GPT-4',active:false,calls:17,satisfaction:4.1}
      ]);
      const promptTemplates=ref([
        {id:1,name:'结构化摘要',icon:'fa-solid fa-align-left',color:'#409EFF',desc:'生成文档段落级摘要，保留关键信息',tags:['摘要','结构化']},
        {id:2,name:'知识抽取',icon:'fa-solid fa-brain',color:'#67C23A',desc:'从文本中抽取实体、关系、事件',tags:['NER','知识图谱']},
        {id:3,name:'问答生成',icon:'fa-solid fa-comments',color:'#E6A23C',desc:'基于检索结果生成引用约束回答',tags:['RAG','问答']},
        {id:4,name:'敏感过滤',icon:'fa-solid fa-shield',color:'#F56C6C',desc:'过滤个人隐私与敏感信息',tags:['合规','过滤']},
        {id:5,name:'标题改写',icon:'fa-solid fa-pen',color:'#9370DB',desc:'优化章节标题可读性',tags:['编辑','改写']},
        {id:6,name:'引用校验',icon:'fa-solid fa-quote-right',color:'#8B4513',desc:'校验回答引用是否可追溯',tags:['引用','校验']}
      ]);

      // ===== 元数据 =====
      const metadataData=ref([
        {name:'图书出版元数据',source:'编目系统',fields:24,records:1247,quality:92,lastSync:'2026-06-17 12:00'},
        {name:'结构化元数据',source:'解析引擎',fields:18,records:52384,quality:88,lastSync:'2026-06-17 10:30'},
        {name:'版权授权元数据',source:'版权系统',fields:12,records:892,quality:95,lastSync:'2026-06-17 09:00'}
      ]);

      // ===== MOD-17 数据质量 =====
      const qualityDimensions=ref([
        {name:'完整性',score:94,icon:'fa-solid fa-circle-check',color:'#67C23A'},
        {name:'准确性',score:91,icon:'fa-solid fa-bullseye',color:'#409EFF'},
        {name:'一致性',score:88,icon:'fa-solid fa-equals',color:'#E6A23C'},
        {name:'时效性',score:85,icon:'fa-solid fa-clock',color:'#9370DB'},
        {name:'唯一性',score:97,icon:'fa-solid fa-fingerprint',color:'#F56C6C'},
        {name:'规范性',score:83,icon:'fa-solid fa-ruler',color:'#8B4513'}
      ]);
      const qualityRules=ref([
        {name:'ISBN格式校验',dimension:'规范性',target:'图书元数据',passRate:92,exceptions:8,lastRun:'2026-06-17 08:00'},
        {name:'必填字段检查',dimension:'完整性',target:'编目记录',passRate:88,exceptions:12,lastRun:'2026-06-17 08:00'},
        {name:'版权状态一致性',dimension:'一致性',target:'版权台账',passRate:95,exceptions:3,lastRun:'2026-06-17 08:00'},
        {name:'页码映射完整性',dimension:'完整性',target:'结构化成果',passRate:90,exceptions:6,lastRun:'2026-06-17 08:00'},
        {name:'向量索引覆盖率',dimension:'完整性',target:'知识片段',passRate:93,exceptions:5,lastRun:'2026-06-17 08:00'},
        {name:'敏感信息检测',dimension:'准确性',target:'全文内容',passRate:99,exceptions:1,lastRun:'2026-06-17 08:00'}
      ]);
      const qualityExcVisible=ref(false);const qualityExcRule=ref('');const qualityExceptions=ref([]);
      const openQualityExceptions=(row)=>{
        qualityExcRule.value=row.name;
        qualityExceptions.value=Array.from({length:Math.min(row.exceptions,5)},(_,i)=>({
          resource:['近代教育史料汇编','中医药图鉴·上册','江苏非遗图录','大运河水利史','明代建筑图谱'][i],
          field:['ISBN','作者','CIP','页码','版权'][i],
          current:['缺失','待确认','空','未映射','待确认'][i],
          desc:row.name+'未通过校验',
          suggestion:'请补全'+row.target+'对应字段',
          owner:['刘编辑','李审校','王编辑','张校对','陈编辑'][i]
        }));
        qualityExcVisible.value=true;
      };
      const jumpToFix=(row)=>{
        qualityExcVisible.value=false;
        currentPage.value='asset-catalog';
        const a=assetsData.value.find(x=>x.name===row.resource);
        if(a){selectAsset(a);openEditMetaDialog()}
        showToast('已跳转至'+row.resource+'元数据编辑','info');
      };

      // ===== MOD-18 血缘分析 =====
      const lineageableAssets=computed(()=>assetsData.value.filter(a=>a.maturityLevel!=='L0'));
      const lineageResource=ref('');
      const lineageResourceName=computed(()=>{const a=assetsData.value.find(x=>x.id===lineageResource.value);return a?a.name:''});
      const lineageNodes=ref([]);
      const onLineageResourceChange=()=>{
        const a=assetsData.value.find(x=>x.id===lineageResource.value);
        if(!a){lineageNodes.value=[];return}
        lineageNodes.value=[
          {name:'原始文件',icon:'fa-solid fa-file-pdf',color:'#909399',detail:a.name+'.pdf',taskId:'R'+String(a.id).padStart(3,'0'),batch:'B20260610',page:'-'},
          {name:'解析任务',icon:'fa-solid fa-gears',color:'#409EFF',detail:'PDF智能解析',taskId:'T202606100'+a.id,batch:'B20260610',page:'全文'},
          {name:'结构化成果',icon:'fa-solid fa-table-cells',color:'#67C23A',detail:'v'+(a.version||'1.0'),taskId:'SR00'+a.id,batch:'B20260610',page:'42-43'},
          {name:'向量索引',icon:'fa-solid fa-vector-square',color:'#E6A23C',detail:a.fragments+'片段',taskId:'VI00'+a.id,batch:'B20260610',page:'-'},
          {name:'RAG回答',icon:'fa-solid fa-robot',color:'#9370DB',detail:'可追溯引用',taskId:'RAG0'+a.id,batch:'-',page:'42'}
        ];
      };
      const lineageDetailVisible=ref(false);const lineageDetailNode=ref(null);
      const openLineageDetail=(node)=>{lineageDetailNode.value=node;lineageDetailVisible.value=true};
      const ragReverseLookup=()=>{
        showToast('RAG引用反查：已列出该资源被引用的所有RAG问答记录','info');
        addAuditLog({action:'检索',target:'RAG引用反查',detail:'资源：'+lineageResourceName.value});
      };

      // ===== MOD-16 版权台账（四卡片从 store.copyrightStats 取，与 overview.authorized 同步）=====
      const copyrightFilter=ref('');const copyrightSearch=ref('');
      const copyrightSummary=computed(()=>({
        confirmed:store.copyrightStats.confirmed,
        pending:store.copyrightStats.pending,
        expiring:store.copyrightStats.expiring30d,
        high:store.copyrightStats.highRisk
      }));
      const filteredCopyrightData=computed(()=>{
        return store.copyrightLedger.filter(c=>{
          if(copyrightSearch.value&&!c.resource.includes(copyrightSearch.value))return false;
          if(copyrightFilter.value==='confirmed'&&c.status!=='confirmed')return false;
          if(copyrightFilter.value==='pending'&&c.status!=='pending')return false;
          if(copyrightFilter.value==='expiring'&&c.status!=='expiring')return false;
          if(copyrightFilter.value==='high'&&c.risk!=='高')return false;
          return true;
        });
      });
      const setCopyrightFilter=(f)=>{copyrightFilter.value=copyrightFilter.value===f?'':f};

      // ===== 权限 =====
      const permissionMatrix=ref([
        {role:'数据治理管理员',catalog:true,upload:true,struct:true,search:true,ai:true,admin:true},
        {role:'责任编辑',catalog:true,upload:true,struct:false,search:true,ai:false,admin:false},
        {role:'校对人员',catalog:false,upload:false,struct:true,search:true,ai:false,admin:false},
        {role:'审校主管',catalog:true,upload:false,struct:true,search:true,ai:true,admin:false},
        {role:'外部调用方',catalog:false,upload:false,struct:false,search:true,ai:true,admin:false}
      ]);
      const permissionLayers=ref([
        {name:'功能级',desc:'菜单/按钮可见性控制'},
        {name:'数据级',desc:'行级/字段级数据过滤'},
        {name:'资源级',desc:'单本图书授权控制'},
        {name:'API级',desc:'接口调用鉴权与限流'},
        {name:'字段级',desc:'敏感字段脱敏与掩码'}
      ]);

      // ===== MOD-23 审计日志 =====
      const auditFilterType=ref('');const auditFilterUser=ref('');
      const filteredAuditLogs=computed(()=>{
        return store.auditLogs.filter(l=>{
          if(auditFilterType.value&&l.action!==auditFilterType.value)return false;
          if(auditFilterUser.value&&!l.user.includes(auditFilterUser.value))return false;
          return true;
        });
      });
      // 近期审计摘要（时间轴展示，取前 6 条）
      const auditTimeline=computed(()=>store.auditLogs.slice(0,6));
      const toggleAuditDetail=(row)=>{/* el-table expand 自动处理 */};

      // ===== 异常预警（绑定 store.alerts）=====
      const alertData=computed(()=>store.alerts.map(a=>({
        level:a.level,rule:a.type,user:'—',detail:a.desc,time:a.time,handled:a.status==='已处理'
      })));
      const handleAlert=(row)=>{if(!row.handled){row.handled=true;showToast('预警已处理','success')}};

      // ===== MOD-21 API 网关 =====
      const apiGroups=computed(()=>[
        {name:'资源服务',icon:'fa-solid fa-database',color:'#409EFF',apis:store.apis.resource},
        {name:'结构化服务',icon:'fa-solid fa-layer-group',color:'#9B59B6',apis:store.apis.structured},
        {name:'检索服务',icon:'fa-solid fa-magnifying-glass',color:'#67C23A',apis:store.apis.search},
        {name:'AI服务',icon:'fa-solid fa-robot',color:'#E6A23C',apis:store.apis.ai},
        {name:'安全服务',icon:'fa-solid fa-shield-halved',color:'#F56C6C',apis:store.apis.security}
      ]);
      const apiTestVisible=ref(false);const apiTestApi=ref(null);const apiTestResponse=ref('');
      const showApiDoc=(row)=>{showToast('接口文档：'+row.path,'info')};
      const testApi=(row)=>{
        apiTestApi.value=row;
        store.apiCallsTodayTotal++;
        addAuditLog({action:'API',actionType:'info',target:row.path,detail:'接口测试调用，方法'+row.method});
        const resp={code:200,message:'success',data:{path:row.path,method:row.method,result:'模拟响应数据',timestamp:new Date().toISOString(),calls:row.callsToday+1}};
        apiTestResponse.value=JSON.stringify(resp,null,2);
        apiTestVisible.value=true;
      };

      // ===== MOD-22 成果回流（初始化自 store，支持交互修改）=====
      const callbackStructured=ref((store.structuredFlowback||[]).map(cb=>({
        id:cb.id,title:cb.dataset+' 回流',module:cb.source,time:cb.time,
        status:cb.status==='回流成功'?'success':cb.status==='失败'?'danger':'pending',
        statusLabel:cb.status,type:cb.status==='回流成功'?'success':cb.status==='失败'?'danger':'warning',
        desc:(cb.count?cb.count+'条，':'')+`质量分${cb.qualityScore}`+(cb.failReason?' · '+cb.failReason:'')
      })));
      const callbackKnowledge=ref((store.knowledgeFlowback||[]).map(cb=>({
        id:cb.id,title:cb.dataset+' 回流',module:cb.source,time:cb.time,
        status:cb.status==='回流成功'?'success':'danger',
        statusLabel:cb.status,type:cb.status==='回流成功'?'success':'danger',
        desc:(cb.count?cb.count+'条，':'')+`质量分${cb.qualityScore}`+(cb.failReason?' · '+cb.failReason:'')
      })));
      const callbackDetailVisible=ref(false);const callbackDetail=ref(null);
      const openCallbackDetail=(cb)=>{callbackDetail.value=cb;callbackDetailVisible.value=true};
      const retryCallback=(cb)=>{
        cb.status='pending';cb.statusLabel='处理中';cb.type='warning';
        addAuditLog({action:'管理',target:cb.title,detail:'重试回流'});
        showToast('已重新发起回流','info');
        setTimeout(()=>{cb.status='success';cb.statusLabel='已回流';cb.type='success';pushNotif(cb.title+'回流成功','fa-solid fa-check','#67C23A','api-callback')},2000);
      };

      // ===== 运营反馈（绑定 store 数据）=====
      const feedbackRagLogs=computed(()=>[
        {time:'2026-06-17 14:20',query:'明清运河管理',model:'GPT-4',tokens:1280,satisfaction:5},
        {time:'2026-06-17 13:45',query:'中药材功效',model:'Claude-3',tokens:960,satisfaction:4},
        {time:'2026-06-17 11:30',query:'非遗保护政策',model:'GPT-4',tokens:1120,satisfaction:3},
        {time:'2026-06-17 10:15',query:'明代建筑规制',model:'GPT-4',tokens:840,satisfaction:4}
      ]);
      // 映射 store.feedbackHotQuestions.question → 模板用的 .query
      const feedbackHotQuestions=computed(()=>(store.feedbackHotQueries||store.feedbackHotQuestions||[]).map(h=>({
        query:h.query||h.question,count:h.count,trend:h.trend
      })));

      // ===== MOD-07 系统设置（绑定 store.systemConfig）=====
      const orgMode=computed({
        get:()=>store.systemConfig.orgMode,
        set:(val)=>{store.systemConfig.orgMode=val}
      });
      const orgOverview=computed(()=>[
        {name:'凤凰科技社',resources:642,calls:2840},
        {name:'浙大出版社',resources:418,calls:1280},
        {name:'交大出版社',resources:187,calls:616}
      ]);
      const storageEngines=computed(()=>[
        {name:'对象存储OSS',icon:'fa-solid fa-cloud',color:'#409EFF',status:store.systemConfig.objectStorageStatus,size:'2.4TB'},
        {name:'ElasticSearch',icon:'fa-solid fa-search',color:'#67C23A',status:store.systemConfig.elasticsearchStatus,size:'180GB'},
        {name:'向量数据库',icon:'fa-solid fa-vector-square',color:'#E6A23C',status:store.systemConfig.vectorDBStatus,size:'56GB'},
        {name:'关系数据库',icon:'fa-solid fa-database',color:'#F56C6C',status:'正常',size:'12GB'}
      ]);

      // ===== 图表渲染（全部从 store 取，口径与各功能页一致）=====
      let chartInstances={};
      const renderCharts=()=>{
        nextTick(()=>{
          if(currentPage.value!=='dashboard')return;
          // 趋势图 ← store.ingestTrend
          const tEl=document.getElementById('chart-trend');
          if(tEl){
            const t=echarts.init(tEl,isDark.value?'dark':null);
            const trend=store.ingestTrend||[];
            t.setOption({tooltip:{trigger:'axis'},grid:{left:40,right:20,top:30,bottom:30},xAxis:{type:'category',data:trend.map(d=>d.date)},yAxis:{type:'value'},series:[{name:'接入量',type:'line',smooth:true,data:trend.map(d=>d.count),areaStyle:{color:'rgba(64,158,255,.15)'},lineStyle:{color:'#409EFF'},itemStyle:{color:'#409EFF'}}]});
            chartInstances.trend=t;
          }
          // 分布图 ← store.topicDistribution
          const dEl=document.getElementById('chart-distribution');
          if(dEl){
            const d=echarts.init(dEl,isDark.value?'dark':null);
            const td=store.topicDistribution||[];
            d.setOption({tooltip:{trigger:'item'},legend:{bottom:0},series:[{type:'pie',radius:['40%','70%'],data:td.map(x=>({value:x.count,name:x.topic})),itemStyle:{borderRadius:6,borderColor:'#fff',borderWidth:2}}]});
            chartInstances.dist=d;
          }
          // 状态分布 ← store.processStatusDistribution
          const sEl=document.getElementById('chart-status');
          if(sEl){
            const s=echarts.init(sEl,isDark.value?'dark':null);
            const ps=store.processStatusDistribution||[];
            s.setOption({tooltip:{trigger:'item'},series:[{type:'pie',radius:'65%',data:ps.map(x=>({value:x.count,name:x.status,itemStyle:{color:x.color}})),itemStyle:{borderRadius:4}}]});
            chartInstances.status=s;
          }
          // 成熟度 ← store.maturityDistribution
          const qEl=document.getElementById('chart-quality');
          if(qEl){
            const q=echarts.init(qEl,isDark.value?'dark':null);
            const md=store.maturityDistribution||[];
            const colors={L0:'#909399',L1:'#409EFF',L2:'#67C23A',L3:'#E6A23C',L4:'#F56C6C'};
            q.setOption({tooltip:{trigger:'axis'},grid:{left:30,right:15,top:20,bottom:25},xAxis:{type:'category',data:md.map(x=>x.level)},yAxis:{type:'value'},series:[{type:'bar',data:md.map(x=>({value:x.count,itemStyle:{color:colors[x.level]||'#409EFF'}})),barWidth:'50%'}]});
            chartInstances.quality=q;
          }
          // 热词 ← store.hotSearchWords
          const kEl=document.getElementById('chart-keywords');
          if(kEl){
            const k=echarts.init(kEl,isDark.value?'dark':null);
            const hw=store.hotSearchWords||[];
            const palette=['#409EFF','#67C23A','#E6A23C','#F56C6C','#9370DB','#8B4513','#409EFF','#67C23A'];
            const maxC=Math.max(...hw.map(x=>x.count),1);
            k.setOption({tooltip:{},series:[{type:'graph',layout:'force',force:{repulsion:80},data:hw.map((x,i)=>({name:x.word,value:x.count,symbolSize:18+Math.round(x.count/maxC*30),itemStyle:{color:palette[i%palette.length]}})),label:{show:true},links:[]}]});
            chartInstances.keywords=k;
          }
        });
      };

      // 监听页面切换渲染图表
      watch(currentPage,(v)=>{
        if(v==='dashboard'){renderCharts()}
        // 窗口resize时重绘
      });
      watch(isDark,()=>{Object.values(chartInstances).forEach(c=>c&&c.dispose());chartInstances={};if(currentPage.value==='dashboard')renderCharts()});

      onMounted(()=>{
        // 主题初始化
        const saved=localStorage.getItem('kdh-theme');
        if(saved==='dark'){isDark.value=true;document.documentElement.classList.add('dark')}
        // 默认渲染
        setTimeout(renderCharts,300);
      });

      return{
      store,
      isDark,sidebarCollapsed,currentPage,globalSearch,notifPanelOpen,toggleTheme,unreadNotifCount,markAllRead,
      handleNotifClick,handleMenuSelect,onGlobalSearchEnter,showToast,structuredBookCount,dashboardStats,drillDownStat,topics,
      activeTopic,assetSearch,filterType,filterStatus,filterMaturity,viewMode,selectedAsset,detailTab,
      resourceTypes,processStatuses,maturityOptions,assetsData,filteredAssets,selectAsset,pushDialogVisible,onPushToPlatform,
      confirmPush,openStructResultFromAsset,editMetaDialogVisible,editMetaForm,openEditMetaDialog,saveEditMeta,editAuthDialogVisible,editAuthForm,
      openEditAuthDialog,saveEditAuth,downloadDialogVisible,downloadTitle,downloadMsg,downloadAllowed,downloadTarget,onDownloadOriginal,
      onDownloadOriginalFile,confirmDownload,enrollmentData,selectedEnrollment,enrollmentStats,enrollmentIssues,enrollmentAuthItems,getCompletenessItems,selectEnrollment,handleNextAction,submitEnrollment,classificationTree,securityLevels,maturityLevels,
      tagCategories,uploadStep,uploadStatus,uploadStatusType,uploadChecks,businessSystems,uploadDialogVisible,uploadSimulating,
      startUpload,runUploadSimulation,parseEngines,parseDialogVisible,parseForm,openParseDialog,openParseDialogFor,confirmParse,
      parseReportVisible,parseReportData,openParseReport,retryParse,calibrationChapters,structItems,mergeSelected,calibHistory,
      calibHistoryVisible,toggleMergeMode,doMerge,editParaDialogVisible,editParaForm,openEditParagraph,saveEditPara,splitParaDialogVisible,
      splitParaForm,openSplitParagraph,confirmSplit,submitAuditDialogVisible,submitCalibration,confirmSubmitAudit,approveStructAudit,rejectStructAudit,
      structLibSearch,structLibMaturity,structFilterTip,structLibData,filteredStructLib,clearStructFilter,viewStructResult,
      locateOriginalPage,structResultSearch,filteredStructResults,searchQuery,searchResults,searchTip,facets,mockSearchPool,
      doSearch,pdfPreviewVisible,pdfPreviewPage,pdfPreviewTitle,viewOriginalPage,citationDialogVisible,citationText,generateCitation,
      copyCitation,ragContext,addToRagContext,ragChats,activeChat,chats,currentChatMessages,chatInput,
      ragProcessing,ragProcessText,evidenceVisible,citationMode,citationWarnVisible,sourceDetailVisible,sourceDetail,newChat,
      switchChat,onCitationModeChange,sendChat,openCitationDetail,toggleEvidence,aiModels,agentList,promptTemplates,
      metadataData,qualityDimensions,qualityRules,qualityExcVisible,qualityExcRule,qualityExceptions,openQualityExceptions,jumpToFix,
      lineageableAssets,lineageResource,lineageResourceName,lineageNodes,onLineageResourceChange,lineageDetailVisible,lineageDetailNode,
      openLineageDetail,ragReverseLookup,copyrightFilter,copyrightSearch,copyrightSummary,filteredCopyrightData,setCopyrightFilter,permissionMatrix,
      permissionLayers,auditFilterType,auditFilterUser,filteredAuditLogs,auditTimeline,toggleAuditDetail,alertData,handleAlert,
      apiGroups,apiTestVisible,apiTestApi,apiTestResponse,showApiDoc,testApi,callbackStructured,callbackKnowledge,
      callbackDetailVisible,callbackDetail,openCallbackDetail,retryCallback,feedbackRagLogs,feedbackHotQuestions,orgMode,orgOverview,
      storageEngines,renderCharts
    };
    }
  });
  app.use(ElementPlus);
  app.mount('#app');
  </script>
</body>
</html>
